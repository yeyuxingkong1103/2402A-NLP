# 工单编号：人工智能NLP-RAG-功能测试及评估 —— 环境变量样例（复制为 .env 后填入真实 Key）
# 路径一律用正斜杠：写成 D:\模型\bge-m3 时 "\b" 会被 .env 解析成退格符，加载会报路径不存在。

# ===== 大模型：DeepSeek =====
DEEPSEEK_API_KEY=sk-请填入你的Key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_MAX_TOKEN=1024
# 推理型模型（如 deepseek-v4-flash）必须传 none，否则思考过程会吃光 max_tokens 并返回空内容
LLM_REASONING_EFFORT=

# ===== 本地模型路径（正斜杠！）=====
EMBED_MODEL_PATH=D:/模型/bge-m3
RERANK_MODEL_PATH=D:/模型/bge-reranker-v2-m3
DEVICE=cuda
EMBED_DIM=1024
EMBED_BATCH=16
# 重排打分输入截断：不截断会按最长序列 padding，30 条候选打分从 0.6 秒拖到 2 秒以上
RERANK_MAX_CHARS=512

# ===== Milvus / Redis（本机已在运行，勿再跑 docker compose）=====
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=gd7_chunks
REDIS_URL=redis://localhost:6379/0
# 本机 Redis 5.0.14 不支持 RESP3(HELLO)，redis-py 8 必须指定 protocol=2，否则连接直接失败
REDIS_PROTOCOL=2
CACHE_TTL=86400

# ===== 语义分块 =====
CHUNK_SIZE=512
CHUNK_OVERLAP=80
SEM_THRESHOLD=0.62
SEM_MAX_CHUNK=900

# ===== 混合检索（第四步优化会调这三个）=====
VEC_TOP_K=30
BM25_TOP_K=30
FUSION_TOP_K=30
RERANK_TOP_N=8
VEC_WEIGHT=0.7
BM25_WEIGHT=0.3

# ===== 语料与评估 =====
CORPUS_DIR=D:/Users/雨子/Desktop/专高六/liu-专高六/RAG 工单/附件/ccf_competition
API_PORT=8010
# RAGAS 并发压到 2：默认 16 会打满 DeepSeek 限流，把样本静默打成 nan
EVAL_MAX_WORKERS=2
# MinerU 页面多时很慢，可用 0 临时关闭主解析路径（降级到 pymupdf）
MINERU_ENABLED=1
