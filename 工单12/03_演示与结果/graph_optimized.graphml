    <node id="CCID Consulting">
      <data key="d0">organization</data>
      <data key="d1">A consulting firm that produced the report "2008 China IC Market Review and Outlook", which is cited as the source of data on China's IC market application structure and growth.</data>
      <data key="d2">doc-ffae8e16f46e5532dd542fca62bfc7f2-chunk-000</data>
      <data key="d3">unknown_source</data>
    </node>
    <node id="2008 China IC Market Review And Outlook">
      <data key="d0">content</data>
      <data key="d1">A report authored by CCID Consulting in 2008 that reviews and forecasts China's integrated circuit market, including the IC market application structure and growth figures.</data>
      <data key="d2">doc-ffae8e16f46e5532dd542fca62bfc7f2-chunk-000</data>
      <data key="d3">unknown_source</data>
    </node>
    <node id="China IC Market">
      <data key="d0">concept</data>
      <data key="d1">The 2008 Chinese integrated circuit market, whose application structure is broken down by industry; the industrial control sector accounts for 7% of it and grew at 10.5%, ranking second among all application industries.</data>
      <data key="d2">doc-ffae8e16f46e5532dd542fca62bfc7f2-chunk-000</data>
      <data key="d3">unknown_source</data>
    </node>
    <node id="Industrial Control Sector">
      <data key="d0">concept</data>
      <data key="d1">An application industry within China's IC market that held only 7% of the market but achieved a 10.5% growth rate, ranking second among all application industries.</data>
      <data key="d2">doc-ffae8e16f46e5532dd542fca62bfc7f2-chunk-000</data>
      <data key="d3">unknown_source</data>
    </node>
    <node id="Automotive Electronics">
      <data key="d0">concept</data>
      <data key="d1">An application industry within China's IC market that ranked first in growth among all application industries, ahead of the industrial control sector.</data>
      <data key="d2">doc-ffae8e16f46e5532dd542fca62bfc7f2-chunk-000</data>
      <data key="d3">unknown_source</data>
    </node>
    <node id="Electronic Product Manufacturers">
      <data key="d0">organization</data>
      <data key="d1">The dominant customer group for electronic components, spanning multinational OEM manufacturers with revenues in the tens of billions and small firms with revenues of a few hundred thousand yuan; they select suppliers based on purchase price, product quality, service, and supply capability.</data>
      <data key="d2">doc-ffae8e16f46e5532dd542fca62bfc7f2-chunk-000</data>
      <data key="d3">unknown_source</data>
    </node>
    <node id="Electronic Components">
      <data key="d0">artifact</data>
      <data key="d1">Products purchased mainly by electronic product manufacturers, research institutions, maintenance organizations, educational institutions, and electronic technology enthusiasts; demand differs across the R&amp;D, trial production, small-batch, and large-batch stages.</data>
      <data key="d2">doc-ffae8e16f46e5532dd542fca62bfc7f2-chunk-000</data>
      <data key="d3">unknown_source</data>
    </node>
    <node id="OEM Manufacturers">
      <data key="d0">organization</data>
      <data key="d1">Multinational original equipment manufacturers with annual output values in the tens of billions, forming part of the electronic product manufacturer customer base for electronic components.</data>
      <data key="d2">doc-ffae8e16f46e5532dd542fca62bfc7f2-chunk-000</data>
      <data key="d3">unknown_source</data>
    </node>
    <node id="Small Companies">
      <data key="d0">organization</data>
      <data key="d1">Small firms and enterprises with annual output values of a few hundred thousand yuan, forming part of the electronic product manufacturer customer base for electronic components.</data>
      <data key="d2">doc-ffae8e16f46e5532dd542fca62bfc7f2-chunk-000</data>
      <data key="d3">unknown_source</data>
