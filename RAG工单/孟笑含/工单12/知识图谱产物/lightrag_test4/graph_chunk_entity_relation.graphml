    <node id="Information Technology Industry">
      <data key="d0">Information Technology Industry</data>
      <data key="d1">concept</data>
      <data key="d2">The industry in which the company operates, characterized by emerging new technologies and new products and short technology upgrade cycles.</data>
      <data key="d3">doc-c60bf31ac967823de21d6afc2fd6ea18-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1791292538</data>
      <data key="d6" />
    </node>
    <node id="New Technology And New Product Development Risk">
      <data key="d0">New Technology And New Product Development Risk</data>
      <data key="d1">concept</data>
      <data key="d2">The risk that the company's research, development, and trial production of new technologies and products such as next-generation command and control systems and codec equipment fail to generate expected returns, adversely affecting company performance.</data>
      <data key="d3">doc-c60bf31ac967823de21d6afc2fd6ea18-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1791292538</data>
      <data key="d6" />
    </node>
    <node id="High Industry And Customer Concentration Risk">
      <data key="d0">High Industry And Customer Concentration Risk</data>
      <data key="d1">concept</data>
      <data key="d2">The risk arising from the company's high dependence on national defense customers and a concentrated customer base, reflected in high proportions of sales to defense customers and top five customers.</data>
      <data key="d3">doc-c60bf31ac967823de21d6afc2fd6ea18-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1791292538</data>
      <data key="d6" />
    </node>
    <node id="Codec Technology">
      <data key="d0">Codec Technology</data>
      <data key="d1">concept</data>
      <data key="d2">Encoding and decoding technology central to the company's products, with international standards updated every few years and domestic standards, especially military codec standards, continuously iterating and upgrading.</data>
      <data key="d3">doc-c60bf31ac967823de21d6afc2fd6ea18-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1791292538</data>
      <data key="d6" />
    </node>
    <node id="International Codec Technology Standards">
      <data key="d0">International Codec Technology Standards</data>
      <data key="d1">concept</data>
      <data key="d2">International standards for codec technology that are updated every few years, requiring companies to quickly develop technologies adapting to new standards.</data>
      <data key="d3">doc-c60bf31ac967823de21d6afc2fd6ea18-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1791292538</data>
      <data key="d6" />
    </node>
    <node id="Domestic Codec Technology Standards">
      <data key="d0">Domestic Codec Technology Standards</data>
      <data key="d1">concept</data>
      <data key="d2">Domestic standards for codec technology, including military codec technical standards, which are continuously iterated and upgraded.</data>
      <data key="d3">doc-c60bf31ac967823de21d6afc2fd6ea18-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1791292538</data>
      <data key="d6" />
    </node>
    <node id="Military Codec Technology Standards">
      <data key="d0">Military Codec Technology Standards</data>
      <data key="d1">concept</data>
      <data key="d2">A subset of domestic codec technical standards specifically for military use, subject to continuous iteration and upgrading.</data>
      <data key="d3">doc-c60bf31ac967823de21d6afc2fd6ea18-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1791292538</data>
      <data key="d6" />
    </node>
