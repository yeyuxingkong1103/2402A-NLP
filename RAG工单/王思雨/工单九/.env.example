# 工单编号：人工智能NLP-RAG-Graph RAG优化任务
# 复制成 .env 后填写。本文件只放配置键；真实密钥不要提交仓库。
# ⚠ 路径陷阱（本机实测）：写成 D:\模型\bge-m3 时 "\b" 会被 dotenv 解析成退格符，加载即报路径不存在。
#    所有路径一律写成正斜杠 D:/模型/bge-m3。下面按工单要求的键给出，括号内注明本实现实际读取的键。

# ===== 大模型：DeepSeek（工单要求项，必填）=====
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
# 生成长度上限。**本单把它从 08 的 800 收到 300**：实测 4 题口径下，800 时 p50=5086ms（超 3 秒），
# 300 时 p50=2911ms（达标）且 context_precision 仍为 0.80；再收到 250 会让 precision 掉到 0.7167。
# 即：这是"时延 vs 精度"的实测拐点，不是随手改的。
LLM_MAX_TOKENS=300
LLM_TIMEOUT=25
# 单次问答总预算（秒）：检索已耗时超预算即降级返回检索原文，保证响应时间有上界
DEADLINE_S=3.0
# 推理型模型（如 deepseek-v4-flash）必须传 none，否则思考过程吃光 max_tokens 返回空内容
LLM_REASONING_EFFORT=

# ===== 向量库 Milvus（工单要求键为 MILVUS_HOST；本实现沿用 08 工单的 MILVUS_URI）=====
MILVUS_HOST=localhost:19530
MILVUS_URI=http://localhost:19530
# 复用 08 工单已建集合，本单绝不写其它工单集合，也绝不重建
MILVUS_COLLECTION=gd8_chunks

# ===== 缓存 Redis（工单要求项）=====
REDIS_URL=redis://localhost:6379/0
# 本机 Redis 5.0.14 不支持 RESP3(HELLO)，redis-py 必须指定 protocol=2，否则连接直接失败
REDIS_PROTOCOL=2
CACHE_TTL=86400

# ===== 本地模型（工单要求项，务必用正斜杠）=====
BGE_M3_PATH=D:/模型/bge-m3
BGE_RERANKER_PATH=D:/模型/bge-reranker-v2-m3
DEVICE=cuda
EMBED_DIM=1024
# 重排打分输入截断：不截断会按最长序列 padding，把打分从 0.7 秒拖到 2 秒以上
RERANK_MAX_CHARS=512

# ===== 工单九的四层优化旋钮（after 链路；before 链路始终走 08 原参数，不受此影响）=====
# 【检索层】图扩展跳数（08 为 1）与注入 BM25 的邻居词条数（08 为 6）
HOPS=2
EXPAND_TERMS=8
# 【检索层】融合权重：先通道内归一化再加权（08 为 0.7/0.3）
VEC_W=0.6
BM25_W=0.4
# 【检索层】融合候选数（08 为 30）/ 送进大模型的片段数（08 为 8）
FUSION_K=40
RERANK_N=6
# 【检索层】社区摘要 global 通道开关（0=关闭，用于消融实验）
USE_COMM=1
# 【图谱层】最多生成摘要的社区数 / 社区最小成员数
COMM_MAX=12
COMM_MIN=3
# 服务端口（8000 工单五、8010 工单七、8011 工单八已占用）
API_PORT=8012

# ===== 附件的两种替代指定方式（默认找 data/sample_questions.pdf）=====
# SAMPLE_Q_PDF=D:/绝对路径/sample_questions.pdf
# 也可用命令行：python -m app.eval_ragas --sample-pdf D:/路径/sample_questions.pdf
