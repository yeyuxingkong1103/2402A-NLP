{
  "openapi": "3.1.0",
  "info": {
    "title": "金融问答系统容器 API（工单10）",
    "description": "工单编号：人工智能NLP-RAG 项目-金融问答系统部署 —— 金融问答系统容器化对外 API（RAG 基座：工单7）",
    "version": "1.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "存活探针（不碰索引）",
        "description": "仅表示进程存活 —— 容器 HEALTHCHECK 用它，避免索引慢导致容器被误判不健康。",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "就绪探针（索引必须可用）",
        "description": "索引不可用时返回 503（编排系统据此摘流量）。",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "健康检查：索引 / LLM / Redis / 卷",
        "description": "健康检查。始终 200（诚实报告每一子项的 ok），便于运维一眼看清降级原因。",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "服务信息",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Root  Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ask": {
      "post": {
        "summary": "金融问答（核心接口）",
        "description": "单次问答。会话 id 相同即构成多轮（历史落会话卷 + Redis，容器间共享）。",
        "operationId": "ask_api_v1_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/retrieve": {
      "post": {
        "summary": "只检索不生成（诊断）",
        "operationId": "retrieve_api_v1_retrieve_post",
        "parameters": [
          {
            "name": "question",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Question"
            }
          },
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 10,
              "title": "Top K"
            }
          },
          {
            "name": "modality",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Modality"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Retrieve Api V1 Retrieve Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/index": {
      "get": {
        "summary": "索引元信息",
        "operationId": "index_info_api_v1_index_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Index Info Api V1 Index Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "get": {
        "summary": "会话列表（容器间共享的可观测证据）",
        "operationId": "list_sessions_api_v1_sessions_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response List Sessions Api V1 Sessions Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}": {
      "get": {
        "summary": "指定会话的多轮历史",
        "operationId": "get_session_api_v1_sessions__session_id__get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Get Session Api V1 Sessions  Session Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus 指标（文本格式）",
        "description": "Prometheus 文本 exposition 格式，供 compose 里的 prometheus 服务抓取。",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "description": "用户问题（中文/英文）"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "会话 id；多轮追问必传同一 id"
          },
          "lang": {
            "type": "string",
            "pattern": "^(auto|zh|en)$",
            "title": "Lang",
            "description": "语言路径",
            "default": "auto"
          },
          "top_k": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 20.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Top K",
            "description": "检索条数（默认取 RAG_RETRIEVAL__TOP_K）"
          },
          "with_evidence": {
            "type": "boolean",
            "title": "With Evidence",
            "description": "是否返回证据块（诊断用，响应体更大）",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "description": "``POST /api/v1/ask`` 请求体。"
      },
      "AskResponse": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "refused": {
            "type": "boolean",
            "title": "Refused"
          },
          "refusal_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refusal Reason"
          },
          "citations": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Citations"
          },
          "cited_pages": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Cited Pages"
          },
          "latency_ms": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Latency Ms"
          },
          "backend": {
            "type": "string",
            "title": "Backend",
            "default": ""
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": ""
          },
          "generation_method": {
            "type": "string",
            "title": "Generation Method",
            "default": ""
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "zh"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id",
            "default": ""
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "cache": {
            "type": "object",
            "title": "Cache"
          },
          "chunks": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Chunks"
          },
          "evidence": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Evidence"
          },
          "session_turns": {
            "type": "integer",
            "title": "Session Turns",
            "default": 0
          },
          "session_backend": {
            "type": "string",
            "title": "Session Backend",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer",
          "refused"
        ],
        "title": "AskResponse",
        "description": "``POST /api/v1/ask`` 响应体（字段与工单7 的 ``Answer`` 对齐）。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}