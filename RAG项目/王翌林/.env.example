# ===== 项目 =====
PROJECT_ROOT=/home/dabaie/code/psychologist
VENV_PATH=/home/dabaie/code/my_project/.venv
PYTHON_BIN=/home/dabaie/code/my_project/.venv/bin/python
APP_NAME=基于RAG的心理医生多角色陪伴系统
APP_VERSION=1.0.0
DEBUG=false
LOG_DIR=/home/dabaie/code/psychologist/logs
LOG_LEVEL=INFO
DATA_DIR=/home/dabaie/code/psychologist/data

# ===== 模型路径（本地，不走大模型 API）=====
EMBEDDING_MODEL_PATH=/home/dabaie/models/bge-m3
RERANKER_MODEL_PATH=/home/dabaie/models/bge-reranker-v2-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cuda:0
EMBEDDING_BATCH_SIZE=64
HF_HUB_OFFLINE=1

RERANKER_DEVICE=cuda:0
RERANKER_BATCH_SIZE=8
RERANK_TOP_N=5

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=rag_roleplay
DB_USER=dev
DB_PASSWORD=355359
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=persona_knowledge
MILVUS_MEMORY_COLLECTION=user_long_term_memory

# ===== RAG 参数 =====
CHUNK_SIZE=512
CHUNK_OVERLAP=80
PARENT_CHUNK_SIZE=1024
CHILD_CHUNK_SIZE=256
RETRIEVE_TOP_K=20
SIMILARITY_THRESHOLD=0.35
SHORT_TERM_MAX_TURNS=10
SHORT_TERM_TTL=86400
LONG_TERM_SUMMARY_TRIGGER=20
QUERY_REWRITE_ENABLED=true

# ===== 大模型（在线 OpenAI 兼容接口）=====
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-flash
# deepseek-flash 为思考型模型：disabled=直接输出正文（推荐陪伴对话）；enabled=先思考再回答
LLM_THINKING=disabled
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# ===== 鉴权 =====
# 生产环境必须替换为 ≥32 字符的随机串（启动时会校验，缺失/占位符拒绝启动）
JWT_SECRET_KEY=please-generate-a-random-32-char-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12

# ===== 安全 / 危机干预 =====
CRISIS_HOTLINE=12356
EMERGENCY_PHONE=120,110
RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=10
RETRIEVAL_CACHE_TTL=300
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 服务 =====
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ===== 初始化管理员（首次启动自动创建）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-set-admin-password