      <data key="d0">concept</data>
      <data key="d1">The legal person governance structure established by The Company, with organizational structures able to perform duties according to law.</data>
      <data key="d2">doc-60a51f5046e89b8028c2464899fc67ff-chunk-000</data>
      <data key="d3">unknown_source</data>
