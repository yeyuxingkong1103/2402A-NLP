# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
MAX_UPLOAD_SIZE_MB=50
MAX_REQUEST_SIZE_MB=55

# 生产环境必须配置 API_KEY 或 API_KEY_IDENTITIES。单密钥映射到下方默认身份；
# 多租户可使用 JSON：{"replace-with-secret":{"user_id":1001,"tenant_id":1}}
REQUIRE_API_KEY=false
API_KEY=
# API_KEY_IDENTITIES=

# Embedding Configuration
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=32
EMBEDDING_TIMEOUT_SECONDS=30

# Vector Store Configuration
VECTOR_STORE_PROVIDER=milvus
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=kf_chunks
MILVUS_TOKEN=
MILVUS_ENABLE_SPARSE=false

# Database Configuration (Optional)
# 留空 = 不落库，文档元数据只存在内存里，重启后重复上传会重复入向量库；
# 同时会话管理（/api/v1/sessions）会返回 503。
# 填了才会启用 SqlAlchemyMetadataStore（按 SHA256 跳过重复文档）。
# 驱动必须写 pymysql：SQLAlchemy 2.0 的 mysql:// 默认走 MySQLdb，本项目没装。
# charset=utf8mb4 不能省，否则中文文件名/标题会乱码。
# DATABASE_URL=mysql+pymysql://<user>:<password>@127.0.0.1:3306/rag_system?charset=utf8mb4
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis Configuration (Optional)
# 多轮对话的短期记忆存在这里。连不上不会让服务起不来，
# 只是 /chat 退化成无状态单轮问答，会话接口返回 503。
REDIS_URL=redis://127.0.0.1:6379/0
# 没有鉴权时 /chat 用哪个用户身份记会话（需在 users 表里存在）
DEFAULT_USER_ID=1001
DEFAULT_TENANT_ID=1

# LLM Configuration
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60

# RAG Configuration
RAG_TOP_K=5
RAG_RERANK=false
RAG_RERANK_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.5
RAG_MAX_CONTEXT_TOKENS=4000
RAG_ENABLE_PARENT_RETRIEVAL=false
# 低于该重排分数的召回结果视为「没查到」，直接走兜底话术
RAG_RERANK_SCORE_THRESHOLD=0.3

# Reranker Configuration
# lexical = 内置中文词法重排，不需要模型，默认值
# local   = 本地 CrossEncoder（需要 sentence-transformers + 已下载模型）
# bge     = 远程 HTTP 重排服务，需要 RERANKER_BASE_URL
# mock    = 恒定分数，只用于测试，不要在生产用
RERANKER_PROVIDER=lexical
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=
RERANKER_API_KEY=

# 兜底话术里给用户的联系方式（原来是硬编码在代码里的假号码）
SUPPORT_HOTLINE=400-000-0000
SUPPORT_EMAIL=service@example.com
