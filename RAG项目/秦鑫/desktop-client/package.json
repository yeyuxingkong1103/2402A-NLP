{
  "name": "faheng-desktop-client",
  "version": "1.0.0",
  "private": true,
  "description": "法衡 desktop shell for the Dockerized backend",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "44.1.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.faheng.desktop",
    "productName": "法衡",
    "artifactName": "法衡.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "default-server.json",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/faheng.ico",
      "target": [
        "portable"
      ]
    }
  },
  "allowScripts": {
    "electron@44.1.0": true,
    "electron-winstaller@5.4.0": true
  }
}
