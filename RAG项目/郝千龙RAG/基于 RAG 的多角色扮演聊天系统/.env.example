# ===== 环境：development / testing / production =====
APP_ENV=development

# ===== 主数据集（中英翻译句对 TSV）=====
TSV_PATH=c:\Users\h1981\Desktop\中英翻译.tsv

# ===== 大模型（兼容 OpenAI 协议：DeepSeek / 豆包 / 硅基流动 / 千问 / Claude / ChatGPT / Gemini / 本地 vLLM SGLang xInference）=====
LLM_API_KEY=os.environ["DEEPSEEK_API_KEY"]
LLM_BASE_URL=os.environ["DEEPSEEK_BASE_URL"]
LLM_MODEL=deepseek-v4-flash

# ===== 检索 / RAG 参数 =====
TOP_K=6
RERANK_TOP_K=4
SHORT_MEMORY_TURNS=8
SCORE_THRESHOLD=0.0

# ===== 数据库（默认 SQLite；改 MySQL 形如 mysql+pymysql://user:pwd@127.0.0.1:3306/roleplay?charset=utf8mb4）=====
DATABASE_URL=sqlite:///data/app.db

# ===== Redis 短期记忆（REDIS_ENABLED=1 启用）=====
REDIS_ENABLED=0
REDIS_URL=redis://127.0.0.1:6379/0

# ===== Milvus 长期知识库（MILVUS_ENABLED=1 启用，混合检索 BM25 + 向量）=====
MILVUS_ENABLED=0
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=roleplay_kb

# ===== 向量化模型 BGE-m3（EMBEDDING_ENABLED=1 启用）=====
EMBEDDING_ENABLED=0
EMBEDDING_MODEL=models/bge-m3

# ===== 重排序模型 BGE-rerank（RERANK_ENABLED=1 启用）=====
RERANK_ENABLED=0
RERANK_MODEL=BAAI/bge-reranker-base

# ===== 认证 / 服务 =====
SECRET_KEY=dev-secret-change-me
API_HOST=0.0.0.0
API_PORT=8000
DEFAULT_ROLE_CODE=teacher

# ===== HuggingFace 镜像（国内加速下载/校验模型）=====
HF_ENDPOINT=https://hf-mirror.com
