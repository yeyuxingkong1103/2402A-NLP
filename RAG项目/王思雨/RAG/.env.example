# ===== 大模型（LLM）配置 =====
# 大模型 API Key，请复制本文件为 .env 后填入真实值，禁止写进代码
LLM_API_KEY=
# 大模型服务地址（示例为 DeepSeek 官方地址）
LLM_BASE_URL=https://api.deepseek.com/v1
# 大模型名称
LLM_MODEL=deepseek-v4-flash
# 生成温度，越低回答越稳定，电力标准问答建议 0.3
LLM_TEMPERATURE=0.3
# 单次生成最大 token 数
LLM_MAX_TOKENS=2000
# 多轮对话最多带入的历史条数
LLM_HISTORY_LIMIT=10

# ===== MySQL 配置 =====
# MySQL 主机地址
MYSQL_HOST=
# MySQL 端口
MYSQL_PORT=3306
# MySQL 用户名
MYSQL_USER=
# MySQL 密码
MYSQL_PASSWORD=
# MySQL 数据库名
MYSQL_DB=

# ===== Redis 配置 =====
# Redis 主机地址
REDIS_HOST=
# Redis 端口
REDIS_PORT=6379
# Redis 库编号
REDIS_DB=0

# ===== Milvus 向量库配置 =====
# Milvus 主机地址
MILVUS_HOST=
# Milvus 端口
MILVUS_PORT=19530
# Milvus 向量集合名称
MILVUS_COLLECTION=power_repair_docs
# Milvus 连接超时时间（秒）
MILVUS_TIMEOUT=5

# ===== 本地模型路径配置 =====
# BGE-M3 向量模型本地路径
BGE_M3_PATH=D:\模型\bge-m3
# BGE-Reranker-V2-M3 重排模型本地路径
RERANKER_PATH=D:\模型\bge-reranker-v2-m3

# ===== MinerU 解析配置（第 12 步新增，仅用于对比，不进主链路） =====
# MinerU 模型下载源：huggingface / modelscope / local
# 国内直连 HuggingFace 大概率超时，用 ModelScope 镜像
MINERU_MODEL_SOURCE=modelscope
# MinerU 模型目录。注意：mineru 3.4.5 不读这个变量，实际路径来自 ~/mineru.json 的
# models-dir 字段；这里填实际生效的位置，便于核对（本机为 C:/mineru_models，约 4.8 GB）
# 必须用纯 ASCII 路径：fast_langdetect 的 FastText 加载器打不开含中文的路径
MINERU_MODEL_DIR=C:/mineru_models

# ===== 待解析的 PDF 清单 =====
# 逗号分隔，可自由增删；改完要跑一次重建（bash scripts/reindex.sh）才生效
# 写法一：只写文件名 —— 会到上面的 PDF_DIR 目录里找（下面默认就是这种写法）
# 写法二：写完整路径 —— 带盘符（D:\... 或 D:/...）或以 / 开头的视为绝对路径，直接用
# 写法三：留空 —— PDF_FILES= （空值）表示扫描 PDF_DIR 下的全部 PDF，方便临时批量灌数据
PDF_FILES=GBT 17623-2026 绝缘油中溶解气体组分含量的气相色谱测定法.pdf,GBT 25438-2026 三相油浸式立体卷铁芯电力变压器技术参数和要求.pdf,GBT 27743-2025 变压器专用设备检测方法.pdf,GBT 44653-2024 六氟化硫（SF6）气体的现场循环再利用导则.pdf,GBT 46131-2025 特高压变压器用分接开关技术要求与试验方法.pdf

# ===== 数据目录配置 =====
# 待入库的 PDF 资料目录
PDF_DIR=d:\Users\雨子\Desktop\专高六\资料文档

# ===== OCR 模型目录配置 =====
# PaddleOCR 推理模型目录，必须放纯英文路径，中文路径会导致模型文件打不开
OCR_MODEL_DIR=C:/paddleocr_models

# ===== HTTP 服务配置 =====
# 服务监听地址与端口
API_HOST=0.0.0.0
API_PORT=8000
# 跨域白名单，支持 JSON 数组或逗号分隔
API_CORS_ORIGINS=["http://localhost:5173"]

# ===== RAG 优化配置 =====
# 答案缓存过期秒数
CACHE_EXPIRE=3600
# 语义去重的余弦相似度阈值
DEDUP_THRESHOLD=0.95
# 每个父块包含的子块数
PARENT_SIZE=3
# 低质过滤：块最小长度
ENRICH_MIN_LEN=80
# 低质过滤：块最大长度
ENRICH_MAX_LEN=2000

# ===== 记忆与安全配置 =====
# 长期记忆的 Milvus 集合名
MEMORY_COLLECTION=power_repair_memory
# 长期记忆召回条数
MEMORY_TOP_K=3
# 密码哈希盐值，生产环境必须改成随机长字符串
PASSWORD_SALT=change_me_in_prod

# ===== 检索与重排配置 =====
# 精排分数过滤阈值，低于该值的候选被丢弃
RERANK_SCORE_THRESHOLD=0.3
# RRF 融合公式中的常数 k
RRF_K=60
# Milvus 混合检索返回条数
HYBRID_TOP_K=20
# MySQL 路召回条数
MYSQL_RECALL_TOP_K=10
# 精排后最终返回条数
RERANK_TOP_K=5
# MySQL 召回路的融合权重，降低避免历史提问压过知识
MYSQL_RECALL_WEIGHT=0.5
