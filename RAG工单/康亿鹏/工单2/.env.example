# 工单编号：人工智能NLP-RAG-基于PDF文档的问答系统
# 复制本文件为 .env 并填写真实值（.env 不要提交到版本库）

# DeepSeek 大语言模型（OpenAI 兼容接口）
# 注意：变量名须与 config.py 中的 DEEPSEEK_API_KEY1 保持一致
DEEPSEEK_API_KEY1=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Milvus 向量库
MILVUS_URI=http://localhost:19530
# 本地未开启鉴权时留空；Zilliz Cloud 填 API Key；开启鉴权时填 “用户名:密码”
MILVUS_TOKEN=

# 可选：HuggingFace 镜像（模型已使用本地目录，仅在需要联网时生效）
# 说明：嵌入模型与重排模型路径已直接在 config.py 中配置为本地目录：
#   EMBEDDING_MODEL_PATH = D:\models\bge-m3
#   RERANKER_MODEL_PATH  = D:\models\bge-reranker-large
# HF_ENDPOINT=https://hf-mirror.com
