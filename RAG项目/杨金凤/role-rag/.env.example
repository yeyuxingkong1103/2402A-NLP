# DeepSeek API Key（必填）
DEEPSEEK_API_KEY1=sk-你的key

# DeepSeek 服务地址（默认官方）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型：deepseek-flash（推荐）或 deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash

# 可选：HuggingFace 镜像（国内访问 huggingface.co 不可达时启用）
HF_ENDPOINT=https://hf-mirror.com

# MySQL 元数据存储（用户/角色/会话）
MYSQL_URL=mysql+pymysql://rag:你的密码@127.0.0.1:3306/role_rag?charset=utf8mb4

# Redis 会话记忆（可选，不配则用默认值）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_ROUNDS=10
REDIS_TTL=86400

# 向量模型：BGE-m3（本地路径，1024 维）
EMBED_MODEL=/mnt/d/models/models/BAAI--bge-m3/snapshots/master
EMBED_DIM=1024

# BGE-reranker 重排序（可选，不配则用默认值）
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RECALL_K=20
RERANK_TOP_K=4
RRF_K=60
SIMILARITY_THRESHOLD=0.5

# 向量库：Milvus（USE_MILVUS=false 时降级为 Chroma）
USE_MILVUS=true
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=hypertension_guide

# 后台管理接口鉴权（X-API-Key）
ADMIN_KEY=你的admin密钥
