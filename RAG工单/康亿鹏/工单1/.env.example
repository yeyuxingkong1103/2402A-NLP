# 工单编号：人工智能NLP-RAG-基于PDF文档的问答系统
# 复制本文件为 .env 并填写真实值（.env 不要提交到版本库）

# DeepSeek 大语言模型（OpenAI 兼容接口）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Milvus 向量库
MILVUS_URI=http://localhost:19530
# 本地未开启鉴权时留空；Zilliz Cloud 填 API Key；开启鉴权时填 “用户名:密码”
MILVUS_TOKEN=

# 可选：模型本地路径 / 设备 / HuggingFace 镜像
# EMBEDDING_MODEL_PATH=D:/models/bge-m3
# RERANKER_MODEL_PATH=D:/models/bge-reranker-v2-m3
# EMBEDDING_DEVICE=cuda
# HF_ENDPOINT=https://hf-mirror.com
