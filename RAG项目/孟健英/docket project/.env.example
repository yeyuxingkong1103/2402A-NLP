# ============ ⚠️ DeepSeek API Key（必填，把下面替换成您的真实Key）============
DEEPSEEK_API_KEY=sk-请替换成您的DeepSeek真实Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ Milvus 向量库 ============
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=medical_knowledge
MILVUS_MEMORY_COLLECTION=user_memory

# ============ Redis 短期记忆 ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
SESSION_TTL=1800

# ============ 模型路径 ============
EMBEDDING_MODEL=BAAI/bge-m3
# 已用 modelscope 下载到项目内，相对项目根目录即可
RERANKER_MODEL=models/bge-reranker-v2-m3
EMBEDDING_DEVICE=cuda

# ============ 检索与相关性 ============
# 已按 bge-reranker-v2-m3 实测校准：相关片段≈0.44，完全无关≈0.00，故取 0.30
# 若出现大量“知识库暂无此内容”，下调到 0.20；若答非所问明显变多，上调到 0.40
RELEVANCE_THRESHOLD=0.3
# 仅当重排模型不可用时才回退到向量余弦分（量纲不同，单独设阈值）
VEC_RELEVANCE_THRESHOLD=0.45
RERANKER_ENABLED=true
RERANK_TOP_N=12
ANSWER_TOP_K=5
# 清单型/用药型问题（多路检索）保留的片段数
LIST_TOP_K=8

# ============ 知识库路径 ============
GUIDELINE_PATH=data/guidelines/国家基层高血压防治管理指南2025版.pdf