# 本地密钥和环境配置
.env
.env.*
!.env.example

# Python 缓存和测试缓存
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 运行日志
logs/
*.log

# 本地模型、虚拟环境和可重新生成的数据
data/models/
data/runtime/
data/processed/

# 用户上传资料和本地数据库不得进入代码仓库
data/uploads/
data_pipeline/user_uploads/
storage/
*.db
*.sqlite
*.sqlite3

# 大模型文件或未完成下载
*.gguf
*.onnx
*.incomplete

# 编辑器和操作系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db

