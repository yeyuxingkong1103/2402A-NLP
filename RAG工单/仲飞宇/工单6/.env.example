# 工单编号：人工智能NLP-RAG-基于PDF文档的问答系统
# 工单编号：人工智能NLP-RAG-基于PDF文档的问答系统优化
# 工单01 - 基于PDF文档的问答系统
# 工单02 - 基于PDF文档的问答系统的优化
#
# 复制为 .env 后按需修改。所有项都有合理默认值，通常无需改动。

# ---------- Ollama ----------
# 留空 = 启动时自动从 `ip route show default` 取网关（WSL2 NAT 模式下即宿主 IP）。
# 【不要写死】该地址每次 WSL 重启都会变。实测当前为 172.27.224.1。
OLLAMA_HOST=
OLLAMA_PORT=11434

LLM_MODEL=qwen3:8b
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# 关闭 qwen3 的思考链。开着的话单次响应十几秒，3 秒指标必挂。
LLM_THINK=false
# 模型常驻，避免反复冷启动（实测冷启动 7.2 秒）
LLM_KEEP_ALIVE=30m
# 【工单02 新增】嵌入模型也要钉住。不传 keep_alive 时 Ollama 默认 5 分钟就卸载，
# 隔几分钟提问要重载 bge-m3 —— 实测 2355ms（热态仅 35ms），直接吃掉 TTFT。
EMBED_KEEP_ALIVE=30m
# KV cache 大小，别放大 —— 8GB 显存很紧张
LLM_NUM_CTX=4096
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.1

# ---------- Milvus ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_chunks

# ---------- 显存预算 ----------
# 查询时把 bge-m3 放到 CPU 上跑，把显存全留给 qwen3，避免互踢导致冷启动。
# 实测：开启后 TTFT 从 6117ms 降到 35ms（冷启动消失）。
# 【注意】正因为它跑在 CPU、不占显存，才**不需要**设 OLLAMA_MAX_LOADED_MODELS=2；
# 若改成 false（bge-m3 上 GPU），两个模型就会真抢显存，那时必须设。
EMBED_QUERY_ON_CPU=true

# ---------- 检索剖面（工单02）----------
# baseline = 朴素地板 / delivered = 工单01 交付版 / optimized = 工单02 优化版
RETRIEVAL_PROFILE=delivered

# ---------- 检索 ----------
RETRIEVE_TOP_K=3
# 双路召回时每路的候选池大小（原问句 + 抽象版各取这么多，再并集重排）
RETRIEVE_POOL_SIZE=30
# 每个片段送入 LLM 的最大字数。
# 【不要调回 300】实测会切掉答案（id=793 的答案在片段第 336 字处）。
CONTEXT_CHUNK_CHARS=600
# Query 理解时会被抽象掉的实体专名（逗号分隔）。
# 招股书正文用「公司/发行人」自称，不用全称，故查询时去掉。
QUERY_ENTITY_NAMES='["武汉兴图新科电子股份有限公司","武汉兴图新科电子","兴图新科"]'

# ---------- 分块 ----------
CHUNK_MIN_CHARS=300
CHUNK_MAX_CHARS=600
CHUNK_OVERLAP_SENTENCES=1

# ---------- 去重 ----------
SIMHASH_MAX_DISTANCE=3

# ---------- PDF 页码映射 ----------
# 实测：PDF 索引 N ↔ 页脚 1-1-N，偏移为 0。
# 改动前请先跑 python scripts/preflight.py 复核。
PAGE_LABEL_OFFSET=0

# ---------- 数据目录 ----------
# 必须放 WSL 原生盘：/mnt/c 是 9p 协议，比 ext4 慢 1–2 个数量级
DATA_DIR=~/rag-data

# ---------- 运行 ----------
# 8GB 显存只能串行推理，并发请求排队（不要调大，会互相抢显存导致都变慢）
MAX_CONCURRENCY=1

# ---------- 工单04：图像内容解析 ----------
# 关掉 = 完整降级回工单03 的行为（14/14），便于 A/B 对照与回滚
IMAGE_ENABLE=true
# 多模态模型。8GB 卡上与 qwen3:8b 互斥，入库时由 pipeline 显式排程卸载
VLM_MODEL=qwen2.5vl:3b
VLM_KEEP_ALIVE=5m
VLM_MAX_TOKENS=800
VLM_TEMPERATURE=0.0
VLM_TIMEOUT=300.0
# 重复惩罚：不压的话某些图会让模型死循环，Ollama 直接 500
VLM_REPEAT_PENALTY=1.3
# 图区渲染 dpi（150 实测把页 71 的图渲成 874x395 px，模型读得清）
IMAGE_RENDER_DPI=150

# ---------- 工单05：多轮对话（Query 理解）----------
# 会话记忆是**进程内**的（刻意不引入 Redis：本工单主题是指代消解，与存储介质无关）。
# 进程重启即失效 —— 这是已知且可接受的限度，写进 docs/工单05-Query理解优化.md。
# 演示「会话过期」时可把它调小，例如 SESSION_TTL_SECONDS=20。
SESSION_TTL_SECONDS=1800
# 单会话保留的轮数 / 送进 prompt 的最近轮数 / 会话数上限（超了 LRU 逐出）
SESSION_MAX_TURNS=8
SESSION_HISTORY_TURNS=3
SESSION_MAX_SESSIONS=64
# history 与本次 context **共享** num_ctx 预算的硬闸门（字符数）。
# 【不要调大】实测 context 最大 2470 字、提示词可用约 3896 token；超了 Ollama 会
# 静默截断（切掉 system/context，接口照常 200 而答案凭空消失）。
SESSION_PROMPT_BUDGET_CHARS=2600
# 默认只把「改写后的问题」放进 history，不放答案（5 轮剧本没有任何一轮需要读上一轮答案）
SESSION_HISTORY_WITH_ANSWERS=false

# 改写：规则优先；规则认不出疑似指代/省略时才调模型兜底
QUERY_REWRITE_LLM_FALLBACK=true
QUERY_REWRITE_TIMEOUT=20.0
QUERY_REWRITE_MAX_TOKENS=200
# 问点模板向前回溯的轮数（用户先聊了一轮没有公司的泛问，再问「那力源呢？」）
QUERY_INTENT_LOOKBACK=2

# ---------- 工单06：混合检索 ----------
# 三种检索模式：vector（稠密向量）/ fulltext（自建倒排索引）/ hybrid（两者融合）
# 剖面 profile 里已内置对应取值（hybrid / fulltext / hybrid_weighted / hybrid_milvus …），
# 也可以在请求里按需覆盖（前端问答页的「模式/融合/权重/重排器」四个控件）。
# 融合算法：rrf（倒数排名融合，即工单说的"投票机制"，默认）/ weighted（加权平均）
# 关键词权重：hybrid 下关键词路的权重（0~1），0 = 等价纯向量，1 = 等价纯全文
# 重排器：lexical（词法覆盖率，默认）/ tfidf / llm / feedback / none
