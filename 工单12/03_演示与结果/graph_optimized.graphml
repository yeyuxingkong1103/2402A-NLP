      <data key="d2">doc-46919d0eebd23265d0e4a36c8561e953-chunk-000</data>
      <data key="d3">unknown_source</data>
    </node>
    <node id="Customer">
      <data key="d0">organization</data>
      <data key="d1">A customer that receives new products, new technologies, reference design solutions, and technical support from IC distributors, and whose needs should be satisfied by sales platforms.</data>
      <data key="d2">doc-46919d0eebd23265d0e4a36c8561e953-chunk-000</data>
      <data key="d3">unknown_source</data>
    </node>
    <node id="IC Supply Chain Transmission Cooperation Relationship">
      <data key="d0">concept</data>
      <data key="d1">A cooperative relationship formed between distributors and customers under a deep technical service model, including transmission cooperation for new products and new technologies.</data>
      <data key="d2">doc-46919d0eebd23265d0e4a36c8561e953-chunk-000</data>
      <data key="d3">unknown_source</data>
    </node>
    <node id="New Product">
      <data key="d0">artifact</data>
