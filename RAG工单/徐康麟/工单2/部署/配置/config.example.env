# =============================================================================
# 工单2 · 可覆盖配置示例（人工智能NLP-RAG-基于PDF文档的问答系统优化）
# 阶段：部署 / 配置
# =============================================================================
# 用法（Linux）：
#     set -a; source 部署/配置/config.example.env; set +a
#     ./部署/脚本/run_app.sh
# 用法（Windows PowerShell）：
#     Get-Content 部署\配置\config.example.env | Where-Object { $_ -match '^\s*[A-Z]' } |
#       ForEach-Object { $kv = $_ -split '=',2; Set-Item "Env:$($kv[0].Trim())" $kv[1].Trim() }
#
# 规则
#   1) 变量名格式固定为 RAG_<SECTION>__<FIELD>（**双下划线**分隔），大小写不敏感，
#      取值必须与 研发/app/core/config.py 中 Settings 的字段一一对应；
#      config.py 会**拒绝并记录**未知字段（settings 的 _REJECTED_ENV），不会静默生效。
#   2) 本文件列出的默认值 = 本机实测默认值（由 `研发/app/main.py health` 与
#      config.py 默认值导出），**带 [改] 标记的为建议在算力云上修改的项**。
#   3) 不要在此文件里写密钥真值；VLLM_API_KEY / RAG_LLM__API_KEY 请用环境注入。
# =============================================================================

# ------------------------------------------------------------------ 应用
RAG_APP__APP_NAME="基于 PDF 文档的 RAG 问答系统（工单2 优化版）"   # 取值含空格 → 必须加引号，否则 bash source 会把后续词当命令
RAG_APP__VERSION=2.0.0
RAG_APP__FIRST_TOKEN_BUDGET_SECONDS=3.0          # 首字预算（验收红线 ≤3s）
RAG_APP__UNKNOWN_ANSWER=不清楚
RAG_APP__LLM_UNAVAILABLE_ANSWER=服务暂时不可用，请稍后再试
RAG_APP__PAGE_FILTER_EMPTY_ANSWER=指定页码未检索到内容
RAG_APP__LOG_LEVEL=INFO                            # DEBUG/INFO/WARNING/ERROR/CRITICAL
RAG_APP__LOG_JSON=true                             # 日志走 JSON Lines（验收要求）
RAG_APP__EXPOSE_INTERMEDIATE_STEPS=false

# ------------------------------------------------------------------ 路径 [改]
# 云端把数据盘挂到 /data 时，用这些变量覆盖（默认值基于 PROJECT_ROOT 推导）。
# RAG_PATHS__PROJECT_ROOT=/workspace
# RAG_PATHS__SOURCE_ROOT=/workspace/研发
# RAG_PATHS__DATA_RAW=/data/raw
# RAG_PATHS__DATA_PROCESSED=/data/processed
# RAG_PATHS__DATA_INDEX=/data/index
# RAG_PATHS__EVAL_RESULTS=/workspace/优化/评估结果
# RAG_PATHS__LOGS=/workspace/部署/日志
# RAG_PATHS__TEST_DATA=/workspace/测试/测试数据
# RAG_PATHS__SQLITE_PATH=/data/index/rag.sqlite3
# RAG_PATHS__DEFAULT_PDF=/data/raw/招股说明书1.pdf

# ------------------------------------------------------------------ PDF 解析
RAG_PDF__MIN_LINE_CHARS=2
RAG_PDF__EXTRACT_TABLES=true
RAG_PDF__CONTINUE_ON_TABLE_ERROR=true              # 单页表格失败不中断整篇
RAG_PDF__MERGE_CROSS_PAGE_TABLES=true
RAG_PDF__MAX_CELL_CHARS=200

# ------------------------------------------------------------------ 分块
RAG_CHUNK__CHUNK_SIZE=500
RAG_CHUNK__CHUNK_OVERLAP=80
RAG_CHUNK__TABLE_AS_SINGLE_CHUNK=true
RAG_CHUNK__MIN_CHUNK_CHARS=30
RAG_CHUNK__ABSORB_MIN_CHARS=80
RAG_CHUNK__TABLE_SUMMARY_CHARS=160
RAG_CHUNK__MAX_HEADING_LEVELS=4

# ------------------------------------------------------------------ 嵌入 [改]
RAG_EMBEDDING__BACKEND=ollama                      # ollama | sentence_transformers | auto
RAG_EMBEDDING__OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_EMBEDDING__OLLAMA_MODEL=bge-m3:latest          # 与索引维度绑定，换模型必须重建索引
RAG_EMBEDDING__DIMENSION=1024                      # 索引维度校验；跨维度复用被禁止
RAG_EMBEDDING__TIMEOUT=120.0
RAG_EMBEDDING__OLLAMA_BATCH_SIZE=16
RAG_EMBEDDING__MODEL_NAME=BAAI/bge-small-zh-v1.5   # 降级路径（512 维）
RAG_EMBEDDING__LOCAL_MODEL_DIR=models/bge-small-zh-v1.5
RAG_EMBEDDING__DEVICE=cpu
RAG_EMBEDDING__BATCH_SIZE=32
RAG_EMBEDDING__NORMALIZE=true

# ------------------------------------------------------------------ 检索（优化核心参数）
RAG_RETRIEVAL__VECTOR_TOP_K=20
RAG_RETRIEVAL__BM25_TOP_K=20
RAG_RETRIEVAL__FUSION_TOP_K=20
RAG_RETRIEVAL__RERANK_POOL_SIZE=70                 # 重排候选池
RAG_RETRIEVAL__VALUE_AUGMENT_ENABLED=true          # 数值型问题「多值齐备度」召回补充
RAG_RETRIEVAL__VALUE_AUGMENT_TOP_N=60
RAG_RETRIEVAL__RERANK_TOP_N=5                      # 最终送入生成器的片段数
RAG_RETRIEVAL__VECTOR_WEIGHT=0.55
RAG_RETRIEVAL__BM25_WEIGHT=0.45
RAG_RETRIEVAL__BM25_K1=1.5
RAG_RETRIEVAL__BM25_B=0.75
RAG_RETRIEVAL__TABLE_BOOST=1.15
RAG_RETRIEVAL__TABLE_BOOST_HINT=1.25
RAG_RETRIEVAL__NUMERIC_BOOST_MAX=0.30
RAG_RETRIEVAL__MULTI_PERCENT_BOOST=1.05
RAG_RETRIEVAL__MULTI_PERCENT_MIN_COUNT=3
RAG_RETRIEVAL__DENSITY_BOOST_MAX=0.10
RAG_RETRIEVAL__DENSITY_REFERENCE=0.05
RAG_RETRIEVAL__KEYWORD_BOOST_MAX=0.35              # 需索引携带 keywords 才生效
RAG_RETRIEVAL__TOTAL_BOOST_CAP=1.6                 # 全局加权上限（防止整体抬升）
RAG_RETRIEVAL__BOILERPLATE_PENALTY=0.35            # 释义页降权
RAG_RETRIEVAL__BOILERPLATE_COMPANY_PENALTY=0.55
RAG_RETRIEVAL__BOILERPLATE_SHORT_PENALTY=0.85
RAG_RETRIEVAL__BOILERPLATE_PENALTY_FLOOR=0.30
RAG_RETRIEVAL__FRONT_PAGE_CUTOFF=30
RAG_RETRIEVAL__BOILERPLATE_COMPANY_HITS=3
RAG_RETRIEVAL__BOILERPLATE_SHORT_CHARS=120
RAG_RETRIEVAL__FRAGMENT_HALF_PENALTY=0.55          # 碎片降权
RAG_RETRIEVAL__FRAGMENT_PREFIX_PENALTY=0.75
RAG_RETRIEVAL__MIN_CONFIDENCE_COSINE=0.55          # 拒答阈值（标定：相关 min 0.676 / 无关 max 0.500）
RAG_RETRIEVAL__MIN_RELEVANCE_SCORE=0.35
RAG_RETRIEVAL__MIN_OVERLAP_TERMS=1
RAG_RETRIEVAL__VARIANT_DECAY=0.6                   # 多变体查询衰减
RAG_RETRIEVAL__SEGMENT_RECALL_ENABLED=true         # 子块级召回（解决长块语义稀释）
RAG_RETRIEVAL__SEGMENT_MAX_CHARS=180
RAG_RETRIEVAL__SEGMENT_MIN_CHARS=20
RAG_RETRIEVAL__SEGMENT_MAX_PER_CHUNK=12
RAG_RETRIEVAL__SEGMENT_TOP_K=40
RAG_RETRIEVAL__SEGMENT_PATH_WEIGHT=0.85

# ------------------------------------------------------------------ 重排
RAG_RERANKER__ENABLED=true
RAG_RERANKER__MODE=auto                            # auto | model | rule
RAG_RERANKER__MODEL_PATH=BAAI/bge-reranker-base    # 本机无权重 → 自动回落 rule（不得声称跑过 model）
RAG_RERANKER__BUDGET_MS=500
RAG_RERANKER__WEIGHT_KEYWORD=0.25
RAG_RERANKER__WEIGHT_NUMERIC=0.15
RAG_RERANKER__WEIGHT_VALUE=0.15
RAG_RERANKER__WEIGHT_TYPE=0.05
RAG_RERANKER__WEIGHT_POSITION=0.10
RAG_RERANKER__WEIGHT_FUSION=0.30
RAG_RERANKER__APPLY_RETRIEVAL_PENALTY=true

# ------------------------------------------------------------------ LLM [改]
RAG_LLM__BACKEND=auto                              # auto | ollama | openai | extractive
RAG_LLM__OLLAMA_BASE_URL=http://127.0.0.1:11434    # 本机
RAG_LLM__MODEL=qwen2.5:3b                          # 本机；云端改成 vLLM 暴露的模型名
RAG_LLM__BASE_URL=http://127.0.0.1:8000/v1         # vLLM/SGLang OpenAI 兼容地址
RAG_LLM__API_KEY=EMPTY
RAG_LLM__TEMPERATURE=0.1
RAG_LLM__TOP_P=0.8
RAG_LLM__MAX_TOKENS=512
RAG_LLM__PROBE_TIMEOUT=0.5                         # 探测失败快速失败，避免劣化首字
RAG_LLM__PROBE_MAX_RETRIES=0
RAG_LLM__CONNECT_TIMEOUT=3.0
RAG_LLM__READ_TIMEOUT=60.0
RAG_LLM__MAX_CONTEXT_CHUNKS=5
RAG_LLM__MAX_CHUNK_CHARS=900
RAG_LLM__WARMUP=true
RAG_LLM__ALLOW_EXTRACTIVE_FALLBACK=true            # LLM 不可用/校验不过 → 回退抽取式

# ------------------------------------------------------------------ 会话与语言
RAG_CONVERSATION__MAX_HISTORY_ROUNDS=5
RAG_CONVERSATION__REWRITE_HISTORY_ROUNDS=3
RAG_LANGUAGE__DEFAULT_ANSWER_LANGUAGE=auto         # auto | zh | en
RAG_LANGUAGE__QUERY_BRIDGE=glossary

# ------------------------------------------------------------------ 运行期（非 config.py 字段，供脚本读取）
# PYTHON_BIN=python3
# VLLM_MODEL_PATH=/models/Qwen2.5-7B-Instruct-AWQ
# VLLM_SERVED_NAME=qwen2.5-7b-instruct
# VLLM_PORT=8000
# VLLM_TP_SIZE=1
# SGLANG_PORT=30000
# RAG_UI=auto
# RAG_PORT=8600
