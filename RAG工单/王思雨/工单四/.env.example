# 工单编号：人工智能NLP-RAG-图像内容解析及检索优化
# 本文件由 config.py 启动时载入（已存在的真实环境变量优先，不会被覆盖）。密钥文件，勿提交仓库。
# 路径一律用正斜杠：写成 D:\模型\bge-m3 时 "\b" 会被解析成退格符，加载报路径不存在。
DEEPSEEK_API_KEY=sk-在这里填写你的DeepSeek密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_REASONING_EFFORT=
LLM_TIMEOUT=20

EMBED_MODEL_PATH=D:/模型/bge-m3
RERANK_MODEL_PATH=D:/模型/bge-reranker-v2-m3
CLIP_MODEL_PATH=D:/模型/chinese-clip-vit-base-patch16
DEVICE=cuda
EMBED_DIM=1024

MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=gd4_chunks
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=86400

MINERU_LANGFIX_DIR=C:/mineru_models/langfix
MINERU_ENABLED=1
PADDLEOCR_MODEL_DIR=C:/paddleocr_models
OCR_SCALE=3.0
IMAGE_MIN_PX=120

SEM_CHUNK_MAX=700
SEM_THRESHOLD=0.62
MERGE_MIN=150
VEC_TOP_K=40
BM25_TOP_K=40
RRF_K=60
FUSION_TOP_K=60
RERANK_TOP_N=8
IMAGE_BOOST=1.15

# ===== 说明 =====
# DEEPSEEK_API_KEY：必填。缺了接口会返回"未配置 DEEPSEEK_API_KEY"的友好提示，而不是崩溃。
# CLIP_MODEL_PATH：工单备注要求的多模态模型。首次部署需下载中文 CLIP 权重约 600MB：
#   python -c "from huggingface_hub import snapshot_download as d; d('OFA-Sys/chinese-clip-vit-base-patch16', local_dir='D:/模型/chinese-clip-vit-base-patch16')"
# OCR_SCALE：图像 OCR 放大倍数。实测 1x 会把图表中的负号读丢（"-2.0%" 读成 "2.0%"），3x 才稳定。
# MINERU_LANGFIX_DIR：用户名含中文时 fasttext 打不开模型，缺了这个目录 MinerU 必失败。
# PADDLEOCR_MODEL_DIR：用户名含中文时 Paddle 的 C++ 推理层打不开默认缓存目录，需把模型复制到纯英文路径：
#   cp -r ~/.paddleocr/whl/{det,rec,cls} C:/paddleocr_models/
