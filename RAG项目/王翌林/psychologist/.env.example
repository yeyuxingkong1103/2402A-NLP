# ===== 项目 =====
PROJECT_ROOT=/home/dabaie/code/psychologist
VENV_PATH=/home/dabaie/code/my_project/.venv
PYTHON_BIN=/home/dabaie/code/my_project/.venv/bin/python
APP_NAME=基于RAG的心理医生多角色陪伴系统
APP_VERSION=1.0.0
DEBUG=false
LOG_DIR=/home/dabaie/code/psychologist/logs
LOG_LEVEL=INFO
DATA_DIR=/home/dabaie/code/psychologist/data

# ===== 模型路径（本地，不走大模型 API）=====
EMBEDDING_MODEL_PATH=/home/dabaie/models/bge-m3
RERANKER_MODEL_PATH=/home/dabaie/models/bge-reranker-v2-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cuda:0
EMBEDDING_BATCH_SIZE=64
HF_HUB_OFFLINE=1

RERANKER_DEVICE=cuda:0
RERANKER_BATCH_SIZE=8
RERANK_TOP_N=5

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=rag_roleplay
DB_USER=dev
DB_PASSWORD=355359
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=persona_knowledge
MILVUS_MEMORY_COLLECTION=user_long_term_memory

# ===== RAG 参数 =====
CHUNK_SIZE=512
CHUNK_OVERLAP=80
PARENT_CHUNK_SIZE=1024
CHILD_CHUNK_SIZE=256
RETRIEVE_TOP_K=20
SIMILARITY_THRESHOLD=0.35
SHORT_TERM_MAX_TURNS=10
SHORT_TERM_TTL=86400
LONG_TERM_SUMMARY_TRIGGER=20
QUERY_REWRITE_ENABLED=true

# ===== 大模型（在线 OpenAI 兼容接口）=====
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-flash
# deepseek-flash 为思考型模型：disabled=直接输出正文（推荐陪伴对话）；enabled=先思考再回答
LLM_THINKING=disabled
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# ===== 鉴权 =====
# 生产环境必须替换为 ≥32 字符的随机串（启动时会校验，缺失/占位符拒绝启动）
JWT_SECRET_KEY=please-generate-a-random-32-char-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12

# ===== 安全 / 危机干预 =====
CRISIS_HOTLINE=12356
EMERGENCY_PHONE=120,110
RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=10
RETRIEVAL_CACHE_TTL=300
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 文档解析增强（OCR / MinerU）=====
# 解析降级链：MinerU → PyMuPDF → pdfplumber → PaddleOCR
# MinerU 与 PaddleOCR 依赖重且与主环境冲突，装在独立 venv 中，以子进程方式调用；
# 因此 requirements.txt 刻意不含这两个包。缺少对应 venv 时会自动跳过该级。
OCR_FALLBACK_ENABLED=true       # 文本层过薄时是否触发 PaddleOCR 回退
OCR_MIN_TEXT_LAYER_CHARS=100    # 文本层字符数低于此值判定为扫描件
OCR_TIMEOUT=1800                # OCR 超时基数（秒）；实际超时=min(max(该值, 页数*3), 7200)
# OCR 结果缓存目录（按「文件内容 sha256 + 页码范围」缓存，同书跨角色可复用；不填则用 <项目根>/data/ocr_cache）
# PADDLE_OCR_CACHE_DIR=

MINERU_ENABLED=true             # 文本型 PDF 高质量解析（降级链第 1 级，默认开启）
MINERU_TIER=flash               # flash=纯文本（快）／standard=OCR+版面分析（需额外下载模型）
MINERU_VENV_PATH=/home/dabaie/code/my_project/.venv-mineru/bin/mineru

PADDLE_OCR_VENV_PATH=/home/dabaie/code/my_project/.venv-paddle/bin/python
PADDLE_OCR_LANG=ch              # 中文语料；切英文模型会显著掉点

# WSL 跨平台支持：主程序跑在 Windows 时，用该发行版名包装命令调用 WSL 中的 venv；
# 项目本身运行在 WSL 内时可忽略此项（自动检测 /proc/version）
WSL_DISTRIBUTION=Ubuntu-22.04

# ===== 服务 =====
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ===== 初始化管理员（首次启动自动创建）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-set-admin-password