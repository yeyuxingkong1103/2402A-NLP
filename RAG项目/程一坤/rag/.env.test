# =============================================================================
# 测试环境配置（ENVIRONMENT=test）
#
# test 是独立环境名（映射见 config.py: ENVIRONMENT_ENV_FILE_NAMES）。除沿用
# development 的宽松行为（不做 production 必填校验、日志降噪）外，另有专属语义：
#   - 验证码固定码旁路：**仅 test 环境**接受固定码 "000000"（app/auth/service.py
#     的 _consume_code，供集成测试 auth/review 走完整 HTTP 链路）；
#     development / production 一律拒绝，守卫测试见 tests/test_auth_test_bypass.py。
#   - 集成测试专用环境：scripts/e2e/* 起后端时注入 ENVIRONMENT=test。
# 注意：注册验证码任何环境都不回显（走 SMTP 真发）；development 仅对
# 「密码重置验证码」回显 debug_code。
#
# 与 development 的差异：日志降噪、Redis 用 9 号库、MySQL 用独立测试库、
# 密钥全部假值（测试不应依赖真实外部服务）。
# 本机私有覆盖：加载顺序为先本文件、再项目根 .env（覆盖同名键）、
# 进程环境变量最高——与 development/production 一致（批次 34）。
# =============================================================================

# ---------------- 应用 ----------------
APP_NAME=legal-rag-character
ENVIRONMENT=test
LOG_LEVEL=WARNING

# ---------------- MySQL（独立测试库，避免污染开发数据）----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=legal_rag_test
MYSQL_USER=<test-mysql-user>
MYSQL_PASSWORD=<test-mysql-password>
DATABASE_URL=mysql+pymysql://<user>:<password>@127.0.0.1:3306/legal_rag_test

# ---------------- Redis（9 号库放测试数据，与开发 0 号库隔离）----------------
REDIS_URL=redis://127.0.0.1:6379/9
SESSION_TTL_SECONDS=7200

# ---------------- Milvus（测试集合，严禁与知识库/生产集合混用）----------------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=legal_documents_test
MILVUS_LONG_TERM_COLLECTION_NAME=legal_long_term_memory_test

# ---------------- Embedding（假值：测试不打真实 API）----------------
EMBEDDING_API_BASE_URL=http://127.0.0.1:1/v1/embeddings
EMBEDDING_API_KEY=<test-only-fake-key>
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT_SECONDS=5
EMBEDDING_DIMENSION=1024
EMBEDDING_RETRY_ATTEMPTS=1
EMBEDDING_RETRY_BACKOFF_SECONDS=0.1
EMBEDDING_RETRY_TOTAL_BUDGET_SECONDS=1

# ---------------- Reranker（假值）----------------
RERANKER_API_BASE_URL=http://127.0.0.1:1/v1/rerank
RERANKER_API_KEY=<test-only-fake-key>
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_SECONDS=5

# ---------------- 检索调参（与开发/生产同值，测试口径一致）----------------
REFUSAL_MIN_VECTOR_SCORE=0.6304
RECALL_VECTOR_LIMIT=20
RECALL_KEYWORD_LIMIT=20
RERANK_CANDIDATE_LIMIT=20
SYNONYM_EXPANSION_ENABLED=false
SYNONYM_TABLE_PATH=data/legal_synonyms_v1.json
SYNONYM_EXPANSION_WEIGHT=1.0

# ---------------- LLM（假值）----------------
LLM_API_BASE_URL=http://127.0.0.1:1/v1
LLM_API_KEY=<test-only-fake-key>
LLM_MODEL=<test-only-model>
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=5

# ---------------- 长期记忆 / 会话摘要 ----------------
LONG_TERM_MEMORY_DEDUP_THRESHOLD=0.70
LONG_TERM_MEMORY_TOP_K=5
SESSION_SUMMARY_ENABLED=false

# ---------------- SMTP（假值：测试注入 InMemoryMailer，不发真信）----------------
SMTP_HOST=<test-only-smtp-host>
SMTP_PORT=465
SMTP_USERNAME=test@example.com
SMTP_PASSWORD=<test-only-smtp-auth-code>
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=test@example.com
