# =============================================================================
# 工单编号：人工智能NLP-RAG-解决API 服务并发瓶颈与资源泄漏工单
# 文件：部署/配置/.env.example —— 全部环境变量（阈值配置化，代码里不写死）
#
# 用法：复制成 .env 或直接在启动前 export / $env: 设置。
#   * DEPLOY_*  ← 部署层（工单10 继承：端口/卷/会话后端/Redis）
#   * RAG_*     ← 业务层（工单7 继承：检索/生成/阈值）
#   * PERF_*    ← 工单17 新增：性能优化开关与阈值
#
# ★ 总开关 PERF_ENABLED=0 时，服务行为与工单10 基座**逐位一致**（用于复现基准）。
# =============================================================================

# ----------------------------------------------------------------------------
# 【工单17】性能优化总开关
# ----------------------------------------------------------------------------
PERF_ENABLED=1

# --- F1：HTTP keep-alive 连接池（消除「每请求新建 TCP」）---
PERF_HTTP_POOL_ENABLED=1
PERF_HTTP_POOL_MAX_IDLE=8
PERF_HTTP_POOL_TIMEOUT_S=60
PERF_HTTP_POOL_RETRIES=1

# --- F2：嵌入/生成后端探测结果缓存（消除「每请求一次 /api/tags」）---
PERF_PROBE_CACHE_ENABLED=1
PERF_PROBE_CACHE_TTL_S=60

# --- F3/F4：入口限流与异步路由 ---
#   max_inflight：同时在途上限；queue_max：有界等待位；超出即 429 + Retry-After
#   验收跑（20 并发）用 20/64；生产建议 8/32（单 GPU Ollama 串行推理，放太多只会排队）
PERF_MAX_INFLIGHT=8
PERF_QUEUE_MAX=32
PERF_ACQUIRE_TIMEOUT_S=30
PERF_ASYNC_ROUTES=1

# --- F5：答案缓存上限与 TTL（基座为 512 + 永不过期）---
PERF_ANSWER_CACHE_MAX=256
PERF_ANSWER_CACHE_TTL_S=1800
PERF_CACHE_CHUNK_CHARS=400

# --- F6：sqlite（基座每请求 3~4 次 fsync 串行在同一把锁上）---
PERF_SQLITE_WAL=1
PERF_SQLITE_SYNCHRONOUS=NORMAL
PERF_SQLITE_BATCH=1
PERF_ANSWER_CACHE_TABLE_MAX=2000

# --- F7：Ollama 驻留控制（基座写死 30m 且从不卸载）---
PERF_OLLAMA_KEEP_ALIVE=5m
# 空闲多少秒后自动卸载模型；0 = 不自动卸载（靠 keep_alive 自然过期）
PERF_OLLAMA_IDLE_UNLOAD_S=0

# --- F8：会话文件卷容量治理（基座无上限、无物理删除）---
PERF_SESSION_FILE_MAX=2000
PERF_SESSION_SWEEP_S=300

# --- F9：文档解析队列（对应 RAGFlow 的 Task Executor）---
#   memory = 进程内有界队列（本机等价部署）
#   redis  = 走 Redis LIST（容器编排多副本时用）
PERF_PARSE_BACKEND=memory
PERF_PARSE_WORKERS=2
PERF_PARSE_QUEUE_MAX=32
PERF_PARSE_MAX_PAGES=40

# --- F10：健康检查结果 TTL 缓存（探针不打「载索引 + 读盘」重活）---
PERF_HEALTH_CACHE_S=5

# ----------------------------------------------------------------------------
# 【工单10 继承】部署层
# ----------------------------------------------------------------------------
DEPLOY_API_HOST=0.0.0.0
DEPLOY_API_PORT=8200
DEPLOY_API_TITLE=金融问答系统容器 API（工单17 优化后）
DEPLOY_LOG_DIR=/app/logs
DEPLOY_LOG_LEVEL=INFO
DEPLOY_LOG_JSON=1
DEPLOY_SESSION_DIR=/app/sessions
DEPLOY_SESSION_BACKEND=auto
DEPLOY_SESSION_TTL_S=86400
DEPLOY_SESSION_MAX_TURNS=20
DEPLOY_REDIS_ENABLED=1
DEPLOY_REDIS_URL=redis://redis:6379/0
DEPLOY_REDIS_TIMEOUT_S=0.5
DEPLOY_REDIS_KEY_PREFIX=rag:finqa:
DEPLOY_HEALTH_TIMEOUT_S=2
DEPLOY_ASK_TIMEOUT_S=60
# 基座的 max_concurrency 定义了却零引用（＝没有限流）；工单17 的限流走 PERF_MAX_INFLIGHT
DEPLOY_MAX_CONCURRENCY=4
DEPLOY_WARMUP=1
DEPLOY_WARMUP_WITH_GENERATE=0
DEPLOY_UPLOAD_DIR=/app/data/uploads
DEPLOY_RAG_DATA_DIR=/app/data
DEPLOY_INDEX_DIR=/app/data/index
DEPLOY_MODEL_DIR=/app/data/models
DEPLOY_RUNTIME_DIR=/app/data/runtime
DEPLOY_UI_HOST=0.0.0.0
DEPLOY_UI_PORT=8201
DEPLOY_METRICS_ENABLED=1
DEPLOY_BUILD_REF=17-container

# ----------------------------------------------------------------------------
# 【工单7 继承】业务层（只列与本工单相关的，完整列表见 app/core/config.py）
# ----------------------------------------------------------------------------
RAG_LLM__OLLAMA_BASE_URL=http://host.docker.internal:11434
RAG_LLM__OLLAMA_GEN_MODEL=qwen2.5:3b
RAG_LLM__OLLAMA_EMBED_MODEL=bge-m3:latest
RAG_RETRIEVAL__TOP_K=5
RAG_RETRIEVAL__CACHE_SIZE=512
RAG_DATA__INDEX_DIR=/app/data/index
RAG_LOG__DIR=/app/logs
RAG_LOG__LEVEL=INFO
