# 工单编号：人工智能NLP-RAG-混合检索任务
# 本文件由 app/config.py 启动时载入（已存在的真实环境变量优先，不会被覆盖）。密钥文件，勿提交仓库。
# 路径一律用正斜杠：写成 D:\模型\bge-m3 时 "\b" 会被 .env 解析成退格符，加载会报路径不存在。

# ===== 大模型：DeepSeek =====
DEEPSEEK_API_KEY=sk-填入你自己的DeepSeek密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=25
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.0
# 推理型模型（如 deepseek-v4-flash）必须传 none，否则思考过程会吃光 max_tokens 并返回空内容
LLM_REASONING_EFFORT=
LLM_RETRIES=2

# ===== 本地模型路径（正斜杠！）=====
EMBED_MODEL_PATH=D:/模型/bge-m3
RERANK_MODEL_PATH=D:/模型/bge-reranker-v2-m3
DEVICE=cuda
EMBED_DIM=1024
EMBED_BATCH=16
# 重排打分输入截断：不截断会按最长序列 padding，30 条候选打分从 0.6 秒拖到 2 秒以上
RERANK_MAX_CHARS=512

# ===== Milvus / Redis =====
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=gd6_chunks
MILVUS_TIMEOUT=10
MILVUS_BATCH=256
REDIS_URL=redis://localhost:6379/0
# 本机 Redis 5.0.14 不支持 RESP3(HELLO)，redis-py 8 必须指定 protocol=2，否则连接直接失败
REDIS_PROTOCOL=2
CACHE_TTL=86400
HISTORY_TURNS=6
HISTORY_TTL=7200

# ===== MinerU 解析 =====
MINERU_ENABLED=1
# 中文用户名补丁：该目录内含 sitecustomize.py，必须在子进程 PYTHONPATH 里才会生效（app/ingest.py 已自动注入）。
# 只设本变量是不够的——实测 MinerU 仍会报 "lid.176.ftz cannot be opened"：fasttext 的 C 扩展打不开含中文的用户路径。
MINERU_LANGFIX_DIR=C:/mineru_models/langfix
MINERU_TIMEOUT=7200

# ===== 语义分块 =====
CHUNK_SIZE=512
CHUNK_OVERLAP=80
SEM_THRESHOLD=0.62
SEM_MIN_CHUNK=120
SEM_MAX_CHUNK=900

# ===== 检索 / 融合 / 重排 =====
VEC_TOP_K=30
BM25_TOP_K=30
FUSION_TOP_K=30
RERANK_TOP_N=8
VEC_WEIGHT=0.7
BM25_WEIGHT=0.3
RRF_K=60
W_TITLE=2.0
W_BODY=1.0
W_ABSTRACT=0.6
FUZZY_CUTOFF=80
ADAPTIVE_ALPHA=0.5
CASCADE_MID=12

# ===== 服务与评估 =====
API_HOST=127.0.0.1
# 8000 已被工单五服务占用，本工单固定用 8010
API_PORT=8010
LOG_LEVEL=INFO
EVAL_MAX_WORKERS=2
TARGET_ACCURACY=0.90
TARGET_RECALL=0.95
TARGET_LATENCY=3.0
