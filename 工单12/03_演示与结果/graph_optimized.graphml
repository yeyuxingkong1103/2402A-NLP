      <data key="d2">doc-60a51f5046e89b8028c2464899fc67ff-chunk-000</data>
      <data key="d3">unknown_source</data>
    </node>
    <node id="Improper Management Control Risk">
      <data key="d0">concept</data>
      <data key="d1">The risk that The Company may suffer losses due to inappropriate management control as personnel numbers, customer numbers, organizational structure, and management chain expand.</data>
