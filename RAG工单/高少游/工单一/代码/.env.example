# 本地模型与运行参数（复制为 .env 并按需修改；不复制则使用代码内默认值）
# 所有服务均为本地 Ollama，无需任何外部 API Key

OLLAMA_BASE_URL=http://localhost:11434

# 生成大模型（本地）
LLM_MODEL=deepseek-r1:1.5b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=768
LLM_TIMEOUT=60

# 向量嵌入模型（本地）
EMBEDDING_MODEL=bge-m3:567m
EMBED_BATCH_SIZE=50

# 检索参数
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=8
BM25_TOP_K=6
RANK_FUSION_K=60
VECTOR_COLLECTION=prospectus_qa

# 语音转文字（可选，需安装 openai-whisper）
WHISPER_MODEL=base