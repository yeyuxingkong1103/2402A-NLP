# 复制为 .env 后填写（本文件可安全提交，请勿写入真实密钥）
# 用法见 README.md §2「配置 .env」

# ---- Docker Compose 需要（根目录 .env）----
DEEPSEEK_API_KEY=sk-xxxxxxxx
JWT_SECRET=change-me-in-production-please-set-a-long-random-secret   # 生产环境用 openssl rand -hex 32 生成

# 可选：自定义重排模型 / HuggingFace 镜像
# RERANK_MODEL=BAAI/bge-reranker-base
# HF_ENDPOINT=https://hf-mirror.com

# ---- 本地开发（不经 Docker，可放 backend/.env）----
DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/roleplay
REDIS_URL=redis://localhost:6379/0
MILVUS_HOST=localhost
MILVUS_PORT=19530
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
EMBEDDING_BASE_URL=http://localhost:8080
RERANK_BASE_URL=http://localhost:8081
