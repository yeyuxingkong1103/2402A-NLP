    <node id="Confidentiality Agreement">
      <data key="d0">content</data>
      <data key="d1">Agreement signed between the company and core technical personnel, stipulating that intellectual property generated during employment belongs to the company and that core technical personnel must keep technical and business secrets confidential after leaving.</data>
      <data key="d2">doc-0df17702da72d10a3a7f47e7226b5dac-chunk-000</data>
      <data key="d3">unknown_source</data>
    </node>
    <node id="Intellectual Property">
