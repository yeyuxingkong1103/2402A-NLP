# =============================================================================
# 工单编号：人工智能NLP-RAG 项目-金融问答系统部署
# 文件：部署/配置/.env.example
#
# 用法：
#     Copy-Item 部署/配置/.env.example 部署/配置/.env
#     然后按实际情况改（至少改 HOST_INDEX_DIR 与 REDIS_PASSWORD）
#     docker compose --env-file 部署/配置/.env -f 部署/docker/docker-compose.yml up -d
#
# 约定：
#   * 所有阈值都放这里，代码里不写死（共享约定 §4.3）；
#   * 以 `RAG_` 开头的变量由业务层 app/core/config.py 消费，
#     以 `DEPLOY_` 开头的由部署层 service/config.py 消费，
#     其余为 compose 自身的插值变量（端口映射/卷名/资源限制）。
#   * ⚠️ 本文件不含任何真实密钥，.env 已被 .dockerignore/gitignore 排除，不要提交。
# =============================================================================

# --------------------------------------------------------------------------- #
# 一、镜像与构建
# --------------------------------------------------------------------------- #
IMAGE_TAG=rag-finqa:1.0.0
DEPLOY_BUILD_REF=local-1.0.0
# 基础镜像源（国内网络建议保留清华镜像，见 部署/过程问题记录.md 问题3）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

# --------------------------------------------------------------------------- #
# 二、端口（验收项②「指定端口提供服务」）
# --------------------------------------------------------------------------- #
API_PORT=8200            # rag-api：FastAPI 正式 API（宿主端口）
UI_PORT=8201             # rag-ui ：工单7 中文 Web 界面（宿主端口）
REDIS_PORT=6379
PROM_PORT=9090

# --------------------------------------------------------------------------- #
# 三、宿主机路径（绑定挂载来源）
# --------------------------------------------------------------------------- #
# 索引目录（只读挂载进容器）。默认指向 工单10/工单7索引（指向工单7 索引的目录联接）；
# Windows 也可直接写绝对路径：E:/gao6gongdan/工单7/研发/data/index
# ⚠️ 相对路径基准是 **部署/docker/**（compose 文件所在目录），故前缀是 ../../ 而不是 ../
HOST_INDEX_DIR=../../工单7索引
# 语料目录（可选，增量建索引用）
HOST_RAW_DIR=../../工单7/研发/data/raw

# --------------------------------------------------------------------------- #
# 四、卷名前缀（多环境并行时的隔离手段）
# --------------------------------------------------------------------------- #
VOL_PREFIX=rag-finqa

# --------------------------------------------------------------------------- #
# 五、网络
# --------------------------------------------------------------------------- #
NETWORK_NAME=rag-net
NETWORK_SUBNET=172.28.0.0/16

# --------------------------------------------------------------------------- #
# 六、宿主机 Ollama（生成 + 嵌入后端）
#   Windows/macOS：http://host.docker.internal:11434
#   Linux        ：http://172.17.0.1:11434 或 http://host.docker.internal:11434（需 extra_hosts）
# --------------------------------------------------------------------------- #
RAG_LLM__OLLAMA_BASE_URL=http://host.docker.internal:11434
RAG_LLM__OLLAMA_EMBED_MODEL=bge-m3:latest
RAG_LLM__OLLAMA_GEN_MODEL=qwen2.5:3b
RAG_LLM__REQUEST_TIMEOUT_S=20.0

# --------------------------------------------------------------------------- #
# 七、检索与可答性阈值（业务层；调参不必改代码）
# --------------------------------------------------------------------------- #
RAG_RETRIEVAL__TOP_K=5
RAG_RETRIEVAL__VECTOR_K=20
RAG_RETRIEVAL__RRF_K=60
RAG_RETRIEVAL__PROMPT_TOP_K=3
RAG_ANSWER__MIN_VECTOR_SIMILARITY=0.60
RAG_ANSWER__MIN_KEYWORD_COVERAGE=0.45
RAG_ANSWER__UNKNOWN_TEXT=不清楚

# --------------------------------------------------------------------------- #
# 八、会话共享（验收项③「容器间数据共享」）
# --------------------------------------------------------------------------- #
DEPLOY_SESSION_TTL_S=86400        # 会话过期（秒）
DEPLOY_SESSION_BACKEND=auto       # auto | redis | file
DEPLOY_REDIS_ENABLED=1            # 0 = 完全关闭 Redis，仅用文件卷
DEPLOY_REDIS_URL=redis://:ragfinqa@redis:6379/0
DEPLOY_REDIS_TIMEOUT_S=0.5        # Redis 探活硬超时（避免拖慢问答）
REDIS_PASSWORD=ragfinqa           # ⚠️ 生产必须改
REDIS_MAXMEMORY=256mb

# --------------------------------------------------------------------------- #
# 九、运行期调优（优化/部署优化说明.md 的真实数字都来自这些键）
# --------------------------------------------------------------------------- #
DEPLOY_WARMUP=1                   # 启动时预热检索链路（缩短首请求延迟）
DEPLOY_WARMUP_WITH_GENERATE=0     # 是否连生成模型一起预热（冷启动 +3s 左右）
DEPLOY_MAX_CONCURRENCY=4          # 引擎级并发上限（工单17 压测基准）
DEPLOY_ASK_TIMEOUT_S=60.0
DEPLOY_HEALTH_TIMEOUT_S=2.0
DEPLOY_LOG_JSON=1
RAG_LOG_LEVEL=INFO
TZ=Asia/Shanghai
API_CPUS=2.0
API_MEMORY=2g
UI_CPUS=1.0
UI_MEMORY=1g
REDIS_CPUS=0.5
REDIS_MEMORY=320m
