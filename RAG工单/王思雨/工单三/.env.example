# 工单编号：人工智能NLP-RAG-PDF文档的表格解析及检索优化
# 本文件由 app/config.py 启动时载入（已存在的真实环境变量优先，不会被覆盖）。密钥文件，勿提交仓库。
# 路径一律用正斜杠：写成 D:\模型\bge-m3 时 "\b" 会被当成退格符。
DEEPSEEK_API_KEY=sk-在这里填写你的DeepSeek密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_REASONING_EFFORT=
EMBED_MODEL_PATH=D:/模型/bge-m3
RERANK_MODEL_PATH=D:/模型/bge-reranker-v2-m3
DEVICE=cuda
EMBED_DIM=1024
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=gd3_chunks
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=86400
MINERU_PYTHON=
MINERU_LANGFIX_DIR=C:/mineru_models/langfix
MINERU_TIMEOUT=7200
SEM_CHUNK_MAX=700
SEM_THRESHOLD=0.62
MERGE_MIN=150
VEC_TOP_K=20
BM25_TOP_K=20
FUSION_TOP_K=25
RERANK_TOP_N=6
VEC_WEIGHT=0.7
BM25_WEIGHT=0.3

# ===== 说明 =====
# MINERU_PYTHON：装了 MinerU 的解释器路径。本机 MinerU 与主程序依赖同在一个解释器，故留空；
#   若你的环境把 MinerU 与主程序装在一起，把此项留空即用当前解释器。
# MINERU_LANGFIX_DIR：用户名含中文时 fasttext 打不开模型，缺了这个目录 MinerU 必失败。
