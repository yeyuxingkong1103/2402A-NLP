{
  "title": "RAGFlow API 并发与资源",
  "uid": "ragflow-concurrency",
  "tags": ["ragflow", "工单17"],
  "timezone": "browser",
  "editable": true,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "响应延迟分位（P50 / P95 / P99）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "验收看这条：场景A 要求 P95 ≤3 秒。三条线分别是 50/95/99 分位。",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"lineWidth": 2, "fillOpacity": 5},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "red", "value": 3}
          ]}
        },
        "overrides": []
      },
      "targets": [
        {"refId": "P50", "legendFormat": "P50", "expr": "histogram_quantile(0.50, sum(rate(ragflow_http_request_duration_seconds_bucket[1m])) by (le))"},
        {"refId": "P95", "legendFormat": "P95", "expr": "histogram_quantile(0.95, sum(rate(ragflow_http_request_duration_seconds_bucket[1m])) by (le))"},
        {"refId": "P99", "legendFormat": "P99", "expr": "histogram_quantile(0.99, sum(rate(ragflow_http_request_duration_seconds_bucket[1m])) by (le))"}
      ]
    },
    {
      "id": 2,
      "title": "请求速率与错误数",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "绿线是总 QPS，红线是非 2xx。验收要求「无请求失败」，红线应始终为 0。",
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 5}}, "overrides": []},
      "targets": [
        {"refId": "总QPS", "legendFormat": "总 QPS", "expr": "sum(rate(ragflow_http_requests_total[1m]))"},
        {"refId": "错误", "legendFormat": "非2xx", "expr": "sum(rate(ragflow_http_requests_total{status!~\"2..\"}[1m]))"}
      ]
    },
    {
      "id": 3,
      "title": "在途请求数（并发堆积）",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "同时在被处理的请求数。稳态下应该贴着并发用户数；持续上涨说明有堆积。",
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "targets": [{"refId": "A", "legendFormat": "在途", "expr": "ragflow_http_in_flight_requests"}]
    },
    {
      "id": 4,
      "title": "进程常驻内存（RSS）",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "泄漏验收看这条：连续运行 12 小时后 RSS 增长不得超过 20%。曲线应该走平，不应持续上扬。",
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "targets": [{"refId": "A", "legendFormat": "RSS", "expr": "ragflow_process_resident_memory_bytes"}]
    },
    {
      "id": 5,
      "title": "解析任务队列深度",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Redis Stream 里堆积的解析任务数。场景B（混合负载）里要看到它涨起来又被消费掉。",
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "targets": [{"refId": "A", "legendFormat": "队列长度", "expr": "ragflow_task_queue_depth"}]
    },
    {
      "id": 6,
      "title": "进程 CPU 占用",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "并发下 CPU 打不满，说明瓶颈在等 I/O 而不是在算 —— 这正是工单17 定位到的现象。",
      "fieldConfig": {"defaults": {"unit": "percent", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "targets": [{"refId": "A", "legendFormat": "CPU%", "expr": "ragflow_process_cpu_percent"}]
    },
    {
      "id": 7,
      "title": "各路由 P95",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "按接口分开看，定位是问答接口慢还是上传/解析接口慢。",
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 5}}, "overrides": []},
      "targets": [{"refId": "A", "legendFormat": "{{path}}", "expr": "histogram_quantile(0.95, sum(rate(ragflow_http_request_duration_seconds_bucket[1m])) by (le, path))"}]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
