# 工单编号：人工智能NLP-RAG-基于PDF 文档的问答系统
# 使用操作系统环境变量配置；程序不会自动读取 .env 文件。
# 本地 Ollama 或其他 OpenAI 兼容服务，无 API 密钥时可不设置 LLM_API_KEY。
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_TIMEOUT=2.5
EMBEDDING_BACKEND=auto
EMBEDDING_DEVICE=cpu
# 可选：本地 BGE 模型目录；默认自动查找用户 Hugging Face 缓存。
EMBEDDING_MODEL_PATH=
