# 复制本文件为 .env，再填写真实密钥；不要提交 .env。

# 大语言模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_THINKING=false

# 向量模型、重排模型和多模态模型
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Pro/BAAI/bge-m3
SILICONFLOW_RERANKER_MODEL=Pro/BAAI/bge-reranker-v2-m3
EMBEDDING_DIM=1024
MULTIMODAL_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct

# 联网检索
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_MAX_RESULTS=5

# MinerU API
MINERU_ENABLED=false
MINERU_API_TOKEN=
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm

# 数据库。请将 change_me 替换成自己的密码。
MYSQL_ROOT_PASSWORD=change_me
MYSQL_APP_PASSWORD=change_me
MYSQL_URL=mysql+pymysql://law_rag:change_me@127.0.0.1:3306/law_rag
REDIS_URL=redis://127.0.0.1:6379/0
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=root:Milvus
MILVUS_DATABASE=default
MILVUS_UPLOAD_DATABASE=legal_private

# 服务与上传文件
SERVER_HOST=0.0.0.0
SERVER_PORT=7294
APP_DEBUG=false
CORS_ORIGINS=http://127.0.0.1:7294,http://localhost:7294
UPLOAD_DIR=data/uploads
UPLOAD_MAX_BYTES=20971520
ENABLE_OCR=true
OCR_ENGINE=auto

# 日志和会话
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=data/processed/system_logs
LOG_FILE=law-rag.log
HISTORY_TTL_SECONDS=604800
