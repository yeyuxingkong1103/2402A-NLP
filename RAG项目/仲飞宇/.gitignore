# 虚拟环境
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 本地配置与密钥
.env

# 本地数据 / 日志
data/*.db
data/*.db.lock
data/uploaded/
logs/
*.log

# 语料与下载物：由 scripts/fetch_datasets.py 生成（可重新拉取，且共 29MB）
# 例外是 manifest.json——它是语料可追溯的凭据，要进仓库（见 fetch_datasets.py 注释）。
#
# 注意写成 `data/corpus/*` 而不是 `data/corpus/`：排除目录本身时 git 根本不会进去看，
# 后面的 `!` 例外不会生效（实测 check-ignore 仍命中）；排除「目录下的内容」才行。
data/raw/
data/corpus/*
!data/corpus/manifest.json

# 编辑器
.idea/
.vscode/

# 前端测试依赖（tests/web，见其中 README）
node_modules/
