# ===== LLM（大模型）=====
# provider: ollama | openai_compat | dummy
LLM_PROVIDER=ollama
# Ollama 的 OpenAI 兼容端点
OLLAMA_BASE_URL=http://localhost:11434/v1
# 其他 OpenAI 兼容服务商（硅基流动 / DeepSeek / 豆包 / 千问等）
LLM_BASE_URL=
LLM_API_KEY=ollama
LLM_MODEL=qwen3:0.6b
LLM_TEMPERATURE=0.7

# ===== Embedding（向量化，默认 Ollama bge-m3）=====
# provider: ollama | openai_compat | dummy（dummy 为离线冒烟测试用）
EMBED_PROVIDER=ollama
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3
EMBED_DIM=1024
# 单次 /embeddings 请求的条数上限（可用性参数：Ollama 实测 838 条会 400，512 条正常）
EMBED_BATCH_SIZE=256

# ===== 文档解析 / OCR =====
# 扫描件 PDF / 纯图片（png/jpg/...）兜底识别，默认 RapidOCR（ONNX，模型随包，免联网）。
# 惰性加载：只有真遇到扫描件/图片才初始化（约 0.6s），普通文档零开销。
# 设 false 退回旧行为：图片解析为空、扫描件报「无有效文本」。
OCR_ENABLED=true
# 入库低质量过滤：低于此字符数的 chunk 丢弃（去水印/去噪后的残余噪声）。
MIN_CHUNK_CHARS=10
# 入库时用 LLM 给每个 chunk 生成一句摘要（知识库数据增强）。费 LLM、入库变慢，默认关。
# 这是全局默认值；上传接口的 summary 参数与 `ingest.py --summary` 可对单次入库覆盖它。
SUMMARY_ENABLED=false

# 单次 LLM 请求超时（秒，默认 300）。Ollama 卡住时靠它把线程放回来，
# 别让它吃 OpenAI SDK 默认的 600s、再自动重试两次。
LLM_TIMEOUT=300

# ===== Milvus 向量库 =====
# 本地 Lite：填 .db 文件路径（免服务）；服务器：填 http://host:19530
# 注意：不叫 MILVUS_URI，避免与 pymilvus 自带的环境变量同名冲突
MILVUS_DB_URI=./data/milvus.db
MILVUS_COLLECTION=role_knowledge

# ===== 关系库（用户/角色信息）=====
# SQLite 默认；MySQL 示例：mysql+pymysql://user:pass@host:3306/rag_roleplay
SQL_URL=sqlite:///./data/app.db

# ===== 短期记忆（多轮对话）=====
# backend: memory（进程内） | redis
MEMORY_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
MEMORY_MAX_TURNS=10
# 送进提示词的历史字符预算。轮数只是上限，真正决定装不装得下的是**回答长度**：
# 实测单条 1670 字时 4096 上下文只装得下 3 轮。不裁的话 Ollama 会静默丢最老的几轮。
HISTORY_MAX_CHARS=12000
# 整个提示词（系统消息 + 历史 + 本轮提问）的字符预算。
# 为什么还要这一项：HISTORY_MAX_CHARS 管不到系统消息，而系统消息里是 TOP_K 条
# 检索资料，大小随上传时的 chunk_size 走。实测（qwen3:8b / n_ctx=16384）：
# chunk_size=2000 时 prompt 15355 tokens 还装得下，3000 时 18850 tokens 就超了，
# 服务端静默丢最老轮次。有了整体上限，资料变大时历史会自动让位。
# 两项同时给时取更紧的那个。
PROMPT_MAX_CHARS=14000

# ===== 检索 =====
TOP_K=5
# 稠密向量余弦相似度阈值，低于该值的召回被过滤
SCORE_THRESHOLD=0.3
# 对话时用 LLM 把问题改写/扩写成多个检索查询、多查询召回融合（RAG 优化）。
# 每次对话多一次 LLM 往返，默认关；打开后召回更稳但延迟略增。
QUERY_REWRITE_ENABLED=false
# reranker: score_fusion | bge（bge 需额外启动本地 rerank 服务，见 scripts/run_rerank.sh）
RERANKER=score_fusion
# 精排粗排池宽度（仅 RERANKER=bge 时生效）：先宽召回这么多条再精排截断回 TOP_K。
# 若等于 TOP_K，精排只能重排无法换人，等于白开精排。默认 4x TOP_K。
RERANK_POOL=20
# bge 重排服务地址（本地默认 127.0.0.1:8001；硅基流动等在线服务改这里 + 填 API key）
RERANK_BASE_URL=http://127.0.0.1:8001/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_DIR=./logs
