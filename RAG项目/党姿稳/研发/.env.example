# ============================================================
# 环境变量模板
# 用法：cp .env.example .env  然后按需修改
# 未设置的项会回落到 config.py 中的默认值
# ============================================================

# ---------------- 运行模式 ----------------
# true  = 本地轻量模式（内存向量库 + JSON 会话历史，无需 Milvus/Redis），适合本机跑通链路
# false = 生产模式（Milvus + Redis），上传算力云后改成 false
LOCAL_MODE=true

# 向量化后端：hash = 离线降级实现（无需下载模型）；bge-m3 = 生产使用
EMBEDDING_BACKEND=hash

# PDF 解析是否启用重型组件（缺失时会自动降级到 PyMuPDF + pdfplumber）
USE_MINERU=false
USE_OCR=false

# ---------------- 大模型 ----------------
# 测试阶段用 deepseek；算力云上 SGLang 部署好 Qwen 后改成 qwen
LLM_PROVIDER=deepseek

# === DeepSeek（测试阶段）===
# ↓↓↓ 在这里填入你的密钥 ↓↓↓
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# === Qwen（算力云 SGLang 部署）===
# 部署完成后把下面的地址换成算力云的公网地址，例如 http://1.2.3.4:8000/v1
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_MODEL=qwen27b
QWEN_API_KEY=EMPTY

LLM_TEMPERATURE=0.7
# 生成阶段保留思维链，思考与正文共用这个额度；上限太小会让正文为空或被截断故留足余量。
# 这是上限不是目标，按实际用量计费。
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=120

# 意图识别/查询改写/探活这类短任务的思维链开关。
# 推理模型（如 deepseek 的 reasoner 系列）思考会先占满 max_tokens 导致正文为空，
# 故默认 none 关闭；留空表示不传该参数（SGLang/vLLM 自部署的 Qwen 通常不认这个参数）。
LLM_REASONING_EFFORT=none

# ---------------- Redis（短期记忆）----------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
SHORT_TERM_ROUNDS=5

# ---------------- MySQL ----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=rag_chat

# ---------------- Milvus（向量库）----------------
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=

# ---------------- 向量与重排模型 ----------------
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ---------------- 检索参数 ----------------
VECTOR_TOP_K=10
BM25_TOP_K=10
RERANK_TOP_K=5
SIMILARITY_THRESHOLD=0.3
DUPLICATE_THRESHOLD=0.95
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_BM25_WEIGHT=0.5

# ---------------- 分块参数 ----------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
PARENT_CHILD_RATIO=3
MIN_CHUNK_LENGTH=10

# ---------------- 日志 ----------------
LOG_LEVEL=INFO
LOG_TO_CONSOLE=true
