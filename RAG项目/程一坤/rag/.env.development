# =============================================================================
# 开发环境配置（ENVIRONMENT=development）
#
# 用法：cp .env.development .env.development.local 或直接改本文件后
#       ENVIRONMENT=development 启动（config.py 会按 ENVIRONMENT 选本文件）。
#       未设置 ENVIRONMENT 时默认也走 development；本文件不存在时回退旧单文件 .env。
#
# 安全约定（批次 33 裁决）：本文件只放占位符，真实密钥只放本机，不入交付物。
# 验证码回显：development 下 /api/v1/auth/password-reset/code 响应带 debug_code
# （auth/router.py:75 判 environment == "development"），生产自动关闭，无独立开关键。
# =============================================================================

# ---------------- 应用 ----------------
APP_NAME=legal-rag-character
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ---------------- MySQL（本机 Docker）----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=legal_rag
MYSQL_USER=<your-mysql-user>
MYSQL_PASSWORD=<your-mysql-password>
DATABASE_URL=mysql+pymysql://<user>:<password>@127.0.0.1:3306/legal_rag

# ---------------- Redis（本机 Docker，容器名 my-redis）----------------
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL_SECONDS=86400

# ---------------- Milvus（本机 Docker，容器名 milvus-standalone）----------------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=legal_documents
MILVUS_LONG_TERM_COLLECTION_NAME=legal_long_term_memory

# ---------------- Embedding（BGE-M3，dim 1024）----------------
EMBEDDING_API_BASE_URL=<embedding-endpoint>
EMBEDDING_API_KEY=<your-embedding-api-key>
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_DIMENSION=1024
EMBEDDING_RETRY_ATTEMPTS=3
EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
EMBEDDING_RETRY_TOTAL_BUDGET_SECONDS=15

# ---------------- Reranker（BGE-reranker-v2-m3）----------------
RERANKER_API_BASE_URL=<reranker-endpoint>
RERANKER_API_KEY=<your-reranker-api-key>
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_SECONDS=60

# ---------------- 检索与回答调参（三环境同值，评测口径一致）----------------
# 拒答阈值：两簇中点 0.6304（拒答召回 100% / 非拒答保留 100% / 误拒 0，阶段 8.4 校准）
REFUSAL_MIN_VECTOR_SCORE=0.6304
# 召回窗口 20/20/20（批次 11 实测：40/40/40 反而 Recall@5 0.9286→0.9048）
RECALL_VECTOR_LIMIT=20
RECALL_KEYWORD_LIMIT=20
RERANK_CANDIDATE_LIMIT=20
SYNONYM_EXPANSION_ENABLED=false
SYNONYM_TABLE_PATH=data/legal_synonyms_v1.json
SYNONYM_EXPANSION_WEIGHT=1.0

# ---------------- LLM（OpenAI 兼容接口）----------------
LLM_API_BASE_URL=<llm-endpoint>
LLM_API_KEY=<your-llm-api-key>
LLM_MODEL=<your-llm-model>
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# ---------------- 长期记忆 / 会话摘要 ----------------
LONG_TERM_MEMORY_DEDUP_THRESHOLD=0.70
LONG_TERM_MEMORY_TOP_K=5
SESSION_SUMMARY_ENABLED=false

# ---------------- SMTP（开发环境也要真实发信；本机真实凭据不入库）----------------
SMTP_HOST=<smtp-host>
SMTP_PORT=465
SMTP_USERNAME=<your@qq.com>
SMTP_PASSWORD=<your-smtp-auth-code>
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=<your@qq.com>

# =============================================================================
# P1 扩展预留（当前代码未读取的键与 MinerU/Qwen-VL 见 backend/.env.example 附表）
# =============================================================================
