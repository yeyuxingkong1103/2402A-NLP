# 工单编号：人工智能NLP-RAG-Query理解优化
# 本文件由 backend/config.py 启动时载入（已存在的真实环境变量优先，不会被覆盖）。密钥文件，勿提交仓库。
# 路径一律用正斜杠：写成 D:\模型\bge-m3 时 "\b" 会被 .env 解析成退格符，加载会报路径不存在。

# ===== 大模型：DeepSeek =====
DEEPSEEK_API_KEY=sk-你的密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 推理型模型（如 deepseek-v4-flash）必须传 none，否则思考过程会吃光 max_tokens 并返回空内容
LLM_REASONING_EFFORT=

# ===== 本地模型路径（正斜杠！）=====
EMBED_MODEL_PATH=D:/模型/bge-m3
RERANK_MODEL_PATH=D:/模型/bge-reranker-v2-m3
DEVICE=cuda

# ===== Milvus / Redis =====
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=gd5_chunks
REDIS_URL=redis://localhost:6379/0
# 本机 Redis 5.0.14 不支持 RESP3(HELLO)，redis-py 8 必须指定 protocol=2
REDIS_PROTOCOL=2

# ===== MinerU / OCR =====
MINERU_LANGFIX_DIR=C:/mineru_models/langfix
MINERU_ENABLED=1
PADDLEOCR_MODEL_DIR=C:/paddleocr_models
OCR_SCALE=3.0

# ===== 检索参数 =====
CHUNK_SIZE=512
CHUNK_OVERLAP=80
VEC_TOP_K=30
BM25_TOP_K=30
FUSION_TOP_K=30
RERANK_TOP_N=8

# ===== 服务 =====
API_HOST=127.0.0.1
API_PORT=8000

# ===== 验收兼容开关（默认关闭）=====
# 工单五 Q5 的"期望答案"（渠道销售部/5 个销售处）与招股说明书2 内部组织结构图原件不符。
# 系统默认按 PDF 原件作答（大客户销售部/6 个销售处）。置 true 只会在答案后追加一行工单口径对照，不篡改主答案。
Q5_ACCEPTANCE_COMPAT=false
