# Copy this file to deploy/autodl/.env on the AutoDL server and edit values.

# Path to your downloaded Qwen model on AutoDL.
QWEN_MODEL_PATH=/root/autodl-tmp/Qwen3.8-27b

# The model name exposed by the local OpenAI-compatible server.
QWEN_SERVED_MODEL_NAME=Qwen3.8-27b

# vLLM server settings
VLLM_HOST=127.0.0.1
VLLM_PORT=8001
VLLM_GPU_MEMORY_UTILIZATION=0.88
VLLM_MAX_MODEL_LEN=8192
VLLM_TENSOR_PARALLEL_SIZE=1

# 本文件只启动模型。MySQL、Redis、Milvus、FastAPI 和网页在本地 Ubuntu。
