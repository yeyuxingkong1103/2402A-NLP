# =============================================================================
# 法律 RAG 后端环境变量模板
#
# 用法：cp backend/.env.example .env   （.env 放在**项目根**，不是 backend/ 下）
# 说明：
#   - 本模板**只列代码真实读取的键**（读取点为 backend/app/core/config.py、
#     backend/app/models/embedding.py、backend/app/cli/*、scripts/migrations/backfill_law_dates.py）；
#     与代码对不上的键已全部清理，避免"写了不生效也不报错"。
#   - 所有值都是占位符，**不要**把真实密钥提交进版本库。
#   - 键的顺序按用途分组，便于新增配置时找到归属。
#   - 布尔类取值：true/false（大小写不敏感，也接受 1/yes/on）。
# =============================================================================


# -----------------------------------------------------------------------------
# 应用
# -----------------------------------------------------------------------------
APP_NAME=legal-rag
# 运行环境：development | production
# production 会强制校验下方"模型 API"与"邮件"共 9 个必填键，缺失则启动失败；
# development 走 InMemoryMailer，注册验证码由 /register/code 的 debug_code 回显
ENVIRONMENT=development
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# 数据库（MySQL）—— 检索命中的条文正文来源
# -----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=legal_rag
MYSQL_USER=<your-mysql-user>
MYSQL_PASSWORD=<your-mysql-password>
# SQLAlchemy 连接串：CLI（import_mysql / index_legal_documents）与
# scripts/migrations/backfill_law_dates.py 优先读它；未配置时由上面 5 个 MYSQL_* 拼装
DATABASE_URL=mysql+pymysql://<user>:<password>@127.0.0.1:3306/legal_rag


# -----------------------------------------------------------------------------
# Redis —— 会话令牌 + 短期记忆（滑动窗口）
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
# 会话令牌有效期（秒）。production 下不允许沿用默认值，必须显式配置
SESSION_TTL_SECONDS=7200


# -----------------------------------------------------------------------------
# Milvus —— 向量检索（知识库集合 + 长期记忆集合，两者严禁混用）
# -----------------------------------------------------------------------------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# 知识库集合名（1024 维，与 EMBEDDING_DIMENSION 必须一致）
MILVUS_COLLECTION_NAME=legal_documents
# 长期记忆独立集合名：单独集合是"从存储层杜绝跨用户泄漏"的设计要求，不要改回共用
MILVUS_LONG_TERM_COLLECTION_NAME=legal_long_term_memory


# -----------------------------------------------------------------------------
# 模型 API（1/3）Embedding —— BGE-M3，检索侧与索引侧必须是同一模型
# -----------------------------------------------------------------------------
EMBEDDING_API_BASE_URL=https://<embedding-endpoint>/v1
EMBEDDING_API_KEY=<your-embedding-api-key>
EMBEDDING_MODEL=BAAI/bge-m3
# 必须与 Milvus 集合维度一致，改这里等于要重建集合
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=60
# 重试策略：只重试超时/429/5xx，400/401/403 立即抛错
EMBEDDING_RETRY_ATTEMPTS=3
EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
EMBEDDING_RETRY_TOTAL_BUDGET_SECONDS=15


# -----------------------------------------------------------------------------
# 模型 API（2/3）Reranker —— BGE-reranker-v2-m3
# -----------------------------------------------------------------------------
RERANKER_API_BASE_URL=https://<reranker-endpoint>/v1
RERANKER_API_KEY=<your-reranker-api-key>
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_SECONDS=60
# RRF 融合后送重排的候选上限（与下面两路召回窗口配套调参）
RERANK_CANDIDATE_LIMIT=40


# -----------------------------------------------------------------------------
# 模型 API（3/3）LLM —— OpenAI 兼容接口
# -----------------------------------------------------------------------------
LLM_API_BASE_URL=http://<llm-endpoint>/v1
LLM_API_KEY=<your-llm-api-key>
LLM_MODEL=Qwen2.5-14B-Instruct
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=120


# -----------------------------------------------------------------------------
# 检索与回答调参
# -----------------------------------------------------------------------------
# 向量 / 关键词两路各召回条数（批次10 由 20 放大到 40，实测能救回被 ANN 排在后面的条文）
RECALL_VECTOR_LIMIT=40
RECALL_KEYWORD_LIMIT=40
# 拒答阈值：候选最高向量相似度低于该值直接拒答、不调 LLM。0 = 不启用（仅零候选才拒答）
REFUSAL_MIN_VECTOR_SCORE=0.0
# 同义术语扩写：把口语映射成法条用语，只追加进 BM25 查询；默认关，可一键回退
SYNONYM_EXPANSION_ENABLED=false
SYNONYM_TABLE_PATH=data/legal_synonyms_v1.json
SYNONYM_EXPANSION_WEIGHT=1.0


# -----------------------------------------------------------------------------
# 长期记忆（用户级，可被用户开关关闭）
# -----------------------------------------------------------------------------
# 新摘要与已有记忆余弦相似度 ≥ 该阈值 → 更新原记录而不新增（批次14 实测 0.70）
LONG_TERM_MEMORY_DEDUP_THRESHOLD=0.70
# 注入提示词的记忆条数上限
LONG_TERM_MEMORY_TOP_K=5
# 会话摘要 / 前情：短期记忆窗口满（10 轮）后，被窗口淘汰的更早轮次压成一段
# ≤300 字的前情注入提示词。默认 false = 不读不写不注入（行为与引入前一致）。
# 开启会改变回答的输入，需重跑评测集确认无退化；触发阈值见 app/memory/summary_policy.py
SESSION_SUMMARY_ENABLED=false


# -----------------------------------------------------------------------------
# 邮件（SMTP，发注册验证码）
# production 下 SMTP_HOST / SMTP_USERNAME / SMTP_PASSWORD / SMTP_FROM_EMAIL 必填
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=<your@qq.com>
# QQ 邮箱等使用"授权码"，不是登录密码
SMTP_PASSWORD=<your-smtp-auth-code>
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=<your@qq.com>


# -----------------------------------------------------------------------------
# 部署
# -----------------------------------------------------------------------------
# 本模板中没有部署期键：后端监听地址/端口由启动命令显式指定
# （uvicorn app.main:app --host 0.0.0.0 --port 8010），代码不读，因此不再在 .env 里放
# 一对"改了不生效"的 APP_HOST / APP_PORT。


# =============================================================================
# 附：P1 扩展预留键（**当前代码未读取**，仅登记名称与用途，故全部注释掉）
#
# 接入对应能力时，请同时在 backend/app/core/config.py 里补上读取逻辑，
# 否则会出现"改了 .env 不生效也不报错"的问题。
#
# 文档解析（MinerU，PDF 主路径；批次 22 起代码已读取）
# MINERU_API_BASE_URL=https://mineru.net
# MINERU_API_KEY=
# MINERU_POLL_INTERVAL_SECONDS=5
# MINERU_MAX_POLL_SECONDS=300
# MINERU_LANGUAGE=ch
# MINERU_ENABLE_TABLE=true
# MINERU_ENABLE_FORMULA=true
# MINERU_IS_OCR=false
#
# 图片文档理解（Qwen-VL，PDF 解析的兜底分支）
# QWEN_VL_API_BASE_URL=
# QWEN_VL_API_KEY=
# QWEN_VL_MODEL=qwen-vl-ocr
# QWEN_VL_TIMEOUT_SECONDS=120
# QWEN_VL_MAX_PAGES_PER_REQUEST=8
# 单次请求体上限（base64 后字符数）。这是真正生效的分批约束：
# 请求体超约 2MB 时 qwen-vl-ocr 只返回第一张图的内容（会用丢页换取"调用成功"）
# QWEN_VL_MAX_REQUEST_BYTES=1500000
# =============================================================================
