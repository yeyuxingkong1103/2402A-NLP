APP_NAME=legal-rag
APP_ENV=development
HOST=127.0.0.1
PORT=8000

DATABASE_URL=mysql+pymysql://law_user:law_password@127.0.0.1:3307/law_rag
MYSQL_ROOT_PASSWORD=Your_Password
MYSQL_DATABASE=law_rag
MYSQL_USER=law_user
MYSQL_PASSWORD=law_password

REDIS_URL=redis://127.0.0.1:6379/0
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DOCUMENT_COLLECTION=legal_document_chunks_v2
MILVUS_MEMORY_COLLECTION=user_long_term_memories
MILVUS_EMBEDDING_DIM=1024

JWT_SECRET_KEY=please-change-this-secret-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=Your_Password
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=120

DASHSCOPE_API_KEY=Your_Password
QWEN_VL_MODEL=qwen-vl-max

MINERU_API_URL=https://mineru.net/api/v4/extract/task
MINERU_API_KEY=Your_Password
MINERU_TIMEOUT_SECONDS=180
MINERU_FALLBACK_TO_LOCAL=true

EMBEDDING_MODEL_PATH=model/bge-m3
RERANKER_MODEL_PATH=model/bge-reranker-large
MODEL_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
RERANKER_BATCH_SIZE=8

VECTOR_TOP_K=20
BM25_TOP_K=20
RRF_RESULT_TOP_K=10
RERANK_TOP_K=5
RRF_K=60

DATA_DIR=data
MAX_CHUNK_LENGTH=512
MIN_CHUNK_LENGTH=10
SHORT_MEMORY_TTL_SECONDS=86400
SHORT_MEMORY_WINDOW=10
