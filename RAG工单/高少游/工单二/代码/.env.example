# RAG 问答系统（优化版）环境变量示例
# 复制为 .env 后按需修改；不设置则使用 src/config.py 中的默认值。

# ---- Ollama 本地模型 ----
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=deepseek-r1:1.5b
EMBEDDING_MODEL=bge-m3:567m

# ---- 分块参数（优化后）----
CHUNK_SIZE=700
CHUNK_OVERLAP=120
MIN_CHUNK_SIZE=60
USE_PARENT_CHILD=1

# ---- 检索参数（优化后）----
TOP_K=6
VECTOR_TOP_K=15
BM25_TOP_K=15
RANK_FUSION_K=60
RERANK_TOP_N=6
ANSWER_POOL=25

# 重排权重（加权线性融合，和为 1）
W_VECTOR=0.30
W_BM25=0.20
W_KEYWORD=0.25
W_NUMERIC=0.15
W_ENTITY=0.10

# ---- 答案合成 ----
# extractive：抽取式（默认，快、稳、可溯源）；llm：本地大模型生成
ANSWER_MODE=extractive
EXTRACTIVE_MAX_SENTENCES=3