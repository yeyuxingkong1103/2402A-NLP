# 工单编号：人工智能NLP-RAG-金融问答系统部署
#
# 用法：复制成 .env 再按实际情况改。
#   cp 部署/.env.example 部署/.env
#
# ⚠️ .env 里是本机密钥，不要提交到代码库、也不要打进镜像。
#    Dockerfile 里没有 COPY .env，配置文件也不会被复制进镜像。

# ---------- 大模型（必填）----------
# docker-compose.yml 里用了 ${VAR:?} 语法，这两项没配会直接报错停下，
# 而不是让容器起来之后在运行期才失败。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-在这里填你的密钥

# ---------- 宿主机路径 ----------
# 模型目录：里面应有 bge-m3/ 子目录（约 4.3GB，其中 onnx/ 会被跳过）
MODELS_DIR=D:/Pycharm/yzq/models

# 语料目录：只有 kb-builder 重建知识库时才用得到。
# 指向解压后能看到 pdf/ 与 txt/ 两个子目录的那一层。
CORPUS_DIR=D:/BW/RAG 工单/附件/ccf_competition

# ---------- 端口映射 ----------
# 宿主机端口:容器端口。容器内固定 7860/1935/80，改这里只动宿主机一侧。
APP_PORT=7860
RTMP_PORT=1935
RTMP_HTTP_PORT=8080
