APP_NAME=RAG Roleplay System
APP_ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

PROJECT_ROOT=D:/rag-roleplay-system
DATA_DIR=D:/rag-roleplay-system/data
UPLOAD_DIR=D:/rag-roleplay-system/data/uploads
INDEX_DIR=D:/rag-roleplay-system/data/indexes
LOCAL_VECTOR_INDEX=D:/rag-roleplay-system/data/indexes/chunks.json
LOG_DIR=D:/rag-roleplay-system/logs
DATABASE_URL=sqlite+aiosqlite:///D:/rag-roleplay-system/data/rag_roleplay.db
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

MILVUS_ENABLED=false
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=rag_roleplay_chunks

EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=384
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
RAGAS_ENABLED=false

TOP_K_VECTOR=8
TOP_K_BM25=8
TOP_K_FINAL=6
VECTOR_SCORE_THRESHOLD=0.05
CHUNK_SIZE=600
CHUNK_OVERLAP=80
MAX_MEMORY_MESSAGES=12
