# =============================================================================
# 工单：人工智能NLP-RAG-PDF文档的表格解析及检索优化
# 文件：部署/配置/config.example.env —— 全部可覆盖环境变量样例（含默认值）
#
# 用法（本机 Windows；工作目录 = E:\gao6gongdan\工单3）：
#   pwsh -NoProfile -File 部署/脚本/run_app.ps1 -Mode fallback -Port 8600 -EnvFile 部署/配置/config.example.env
#   pwsh -NoProfile -File 部署/脚本/evaluate.ps1 -EnvFile 部署/配置/config.example.env
#   （run_app.sh 对应 --env-file；两个入口都只是把 KEY=VALUE 写入子进程环境，不做任何隐式转换）
#
# 说明：
#   * 本文件**不含密钥**，可直接入库；真实密钥请另存 config.local.env（应加入忽略清单）。
#   * 变量命名规则来自 设计/接口设计.md §8 与 研发/app/core/config.py::KNOWN_ENV_KEYS，一一对应；
#     未识别的 RAG_* 变量会被 config.load_config 记 WARN（event=config.unknown_env），不会静默忽略。
#   * 所有行都是「键=值」，空值（KEY=）等价于「不设置」= 使用代码内置默认值。
#   * **禁止**在本机执行 pip install（本机断网，会挂死）；缺失依赖见 §Z 段落与
#     部署/配置/环境事实.md §2.2 的替代方案。
# =============================================================================

# -----------------------------------------------------------------------------
# 0. 运行入口（run_py.ps1 使用；config.py 不读取，但属于已识别变量，写了不会 WARN）
# -----------------------------------------------------------------------------
# 覆盖 Python 解释器（默认 E:\gao6gongdan\工单1\.venv\Scripts\python.exe，Python 3.11.15）
#RAG_SCHEDULER_PYTHON=E:\gao6gongdan\工单1\.venv\Scripts\python.exe
# 先切到该目录再执行（默认不切）
#RAG_PY_CWD=E:\gao6gongdan\工单3
# 打印实际解释器与参数（调试用）
#RAG_PY_ECHO=1

# -----------------------------------------------------------------------------
# 1. 路径（config.PathsConfig）
# -----------------------------------------------------------------------------
# 语料目录：**自动发现该目录下全部 *.pdf**（严禁硬编码文件名）
#RAG_DATA__RAW_DIR=E:\gao6gongdan\工单3\研发\data\raw
# 解析产物目录（chunks.jsonl / pages.jsonl / tables.jsonl …）
#RAG_DATA__PROCESSED_DIR=E:\gao6gongdan\工单3\研发\data\processed
# 索引根目录（其下按「嵌入模型_维度」分目录，如 bge-m3_1024）
#RAG_DATA__INDEX_DIR=E:\gao6gongdan\工单3\研发\data\index
# 日志目录：app.log / error.log / rag_trace.jsonl 三文件落盘于此
# T18 说明：logger 已用「O_APPEND + 单次 write + 跨进程文件锁」保证多进程同写一文件不会出现非法 JSON 行
#   （详见 部署/日志/日志字段说明.md §8）；该目录应放在**支持文件锁的本地文件系统**上。
#   若要彻底避免同文件竞争（例如卷在网络共享上），可给每个进程单独指定目录，如 …\部署\日志\run-<run_id>。
#RAG_LOG__DIR=E:\gao6gongdan\工单3\部署\日志
# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
#RAG_LOG__LEVEL=INFO
# 运行号（默认 rYYYYMMDD-HHMMSS）；用于把同一次运行的事件串起来
#RAG_RUN_ID=

# -----------------------------------------------------------------------------
# 2. LLM / 嵌入后端（config.LLMSettings）
#   可插拔优先级：ollama（主）→ openai 兼容 vLLM/SGLang（算力云）→ extractive（无 LLM 兜底）
#   探测超时固定 ≤0.5 s 且**不重试**，避免劣化「首字 ≤3 s」
# -----------------------------------------------------------------------------
# auto | ollama | openai | extractive
RAG_LLM__BACKEND=auto
# 本机 Ollama（实测 0.35.0，/api/embed 返回 1024 维）
RAG_LLM__OLLAMA_BASE_URL=http://127.0.0.1:11434
# 主力生成模型（实测预热后 297 ms/次）
RAG_LLM__OLLAMA_GEN_MODEL=qwen2.5:3b
# 可选强模型兜底：留空 = 关闭（默认）
# 实测打开 deepseek-r1:7b 后首字 4.0~4.8 s、单题总耗时 30~145 s → 破坏「首字 ≤3 s」，默认关闭
#RAG_LLM__OLLAMA_STRONG_MODEL=
# 嵌入模型（索引目录名 = model_slug(model, dim) = bge-m3_1024）
RAG_LLM__OLLAMA_EMBED_MODEL=bge-m3:latest
# —— 算力云：OpenAI 兼容端点（vLLM / SGLang，见 部署/脚本/run_vllm.sh、run_sglang.sh）——
# 置空 = 不使用该后端（本机即为空）
#RAG_LLM__OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# 真实密钥请放在 config.local.env，不要写进本样例文件
#RAG_LLM__OPENAI_API_KEY=
#RAG_LLM__OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct
# 后端探测超时（秒，硬上限 0.5，不得放大：会直接吃掉首字预算）
RAG_LLM__PROBE_TIMEOUT_S=0.5
# 单次生成请求超时（秒）
RAG_LLM__REQUEST_TIMEOUT_S=20.0
# 生成长度上限（tokens）
RAG_LLM__MAX_TOKENS=512
# 采样温度（抽取式作答宜低温）
RAG_LLM__TEMPERATURE=0.2
# 推理模型思维链开关：false → 向 Ollama 传 think=false（deepseek-r1 类模型必设 false）
#RAG_LLM__ENABLE_THINK=true

# -----------------------------------------------------------------------------
# 3. 混合检索（config.RetrievalSettings）
# -----------------------------------------------------------------------------
# 最终返回块数（top-k）；验收要求证据落在 top-5
RAG_RETRIEVAL__TOP_K=5
# 向量单路候选数 / BM25 单路候选数
RAG_RETRIEVAL__VECTOR_K=20
RAG_RETRIEVAL__BM25_K=20
# RRF 常数（越大越平缓）
RAG_RETRIEVAL__RRF_K=60
# 融合权重
RAG_RETRIEVAL__VECTOR_WEIGHT=1.0
RAG_RETRIEVAL__BM25_WEIGHT=1.0
# 表格块加权 / 数字加权 / 关键词加权
RAG_RETRIEVAL__TABLE_BOOST=1.25
RAG_RETRIEVAL__NUMERIC_BOOST=1.15
RAG_RETRIEVAL__KEYWORD_BOOST=1.10
# 数字加权仅对「问数字」的问题生效（实测：关掉会让题 34 等文本题被含数字段落压制）
RAG_RETRIEVAL__NUMERIC_BOOST_REQUIRE_NUMERIC_QUERY=true
# 单路高分救援权重（0=纯 RRF；实测 1.0 可救回「只在一路命中」的块）
RAG_RETRIEVAL__RANK_RESCUE_WEIGHT=1.0
# LLM 重排（默认关闭：增加延迟且实测无增益）
RAG_RETRIEVAL__ENABLE_LLM_RERANK=false

# -----------------------------------------------------------------------------
# 4. 分块（config.ChunkSettings）
# -----------------------------------------------------------------------------
# 目标块长（字符）；文本块按段落/小标题边界优先切分（T5 实测：切纯后命中 10/14→14/14）
RAG_CHUNK__SIZE=500
RAG_CHUNK__OVERLAP=80
# 最小块长（低于此值且非表格块会被并入相邻块）
RAG_CHUNK__MIN_SIZE=120
# 表格 Markdown 的最大字符数（超长表格会截断并记 notes）
RAG_CHUNK__MAX_TABLE_CHARS=4000

# -----------------------------------------------------------------------------
# 5. 可答性闸门（config.AnswerSettings）
#   无依据时必须回「不清楚」，禁止编造
# -----------------------------------------------------------------------------
# 检索分数底线（T6 标定：正样本 min 0.153 / 负样本 max 0.205 → 只作退化底线）
RAG_ANSWER__MIN_SCORE=0.12
# 关键词覆盖率主判据（T6 标定：正样本 min 0.615 / 负样本 max 0.400）
RAG_ANSWER__MIN_KEYWORD_COVERAGE=0.45
# 统一拒答话术
RAG_ANSWER__UNKNOWN_TEXT=不清楚
# 多轮对话携带的历史轮数
RAG_ANSWER__HISTORY_TURNS=5
# 主体类型闸门（题 3/题 4 同页互污染的通用解法）
RAG_ANSWER__ENABLE_SUBJECT_GATE=true

# -----------------------------------------------------------------------------
# 6. 表格解析（config.TableSettings）
# -----------------------------------------------------------------------------
# 表格最小行数/列数（低于则视为退化表，标 degenerate=1 但仍入库）
RAG_TABLE__MIN_ROWS=2
RAG_TABLE__MIN_COLS=2
# 表标题最长字符数（超出不当作标题）
RAG_TABLE__MAX_TITLE_LEN=60

# -----------------------------------------------------------------------------
# 7. 向量库与嵌入（config.VectorStoreSettings / EmbeddingSettings）
# -----------------------------------------------------------------------------
# 是否使用 faiss（默认 false：numpy 精确检索实测 top-5 仅 1.1 ms，无需近似索引）
RAG_VECTOR_STORE__USE_FAISS=false
# 批量嵌入条数
RAG_EMBEDDING__BATCH_SIZE=16

# -----------------------------------------------------------------------------
# 8. 在线服务（FastAPI / 标准库备用界面共用）
# -----------------------------------------------------------------------------
RAG_SERVER__HOST=127.0.0.1
# 默认端口；容器内需设 0.0.0.0 与对外端口映射
RAG_SERVER__PORT=8600

# -----------------------------------------------------------------------------
# 9. 测试（测试/ 目录使用；不是 config.py 的字段）
# -----------------------------------------------------------------------------
# 在线/用户级测试要求本机 Ollama 可用；设为 1 才允许「服务不可用 → 跳过」而不是失败。
# 注意：该键**不在** config.KNOWN_ENV_KEYS 内，一旦取消注释，`config.load_config` 会记一条
# `config.unknown_env` WARN（未识别变量不静默忽略）—— 仅跑测试时临时 export 即可。
#RAG_TEST_ALLOW_ONLINE_SKIP=0

# -----------------------------------------------------------------------------
# Z. 本机缺失依赖（**断网无法安装**）与降级实现路径 —— 不要试图 pip install
#   streamlit          → 本机不跑；改用 部署/脚本/run_app.ps1 -Mode fallback（纯标准库 http.server）
#                        算力云装 streamlit 后：-Mode streamlit（真 Streamlit 应用，未在 test 里声称本机可跑）
#   loguru             → 自实现 loguru 风格 JSON logger（研发/app/core/logging_conf.py），禁止 import loguru
#   pdfplumber         → pymupdf page.find_tables()（逐页扫描，含合并单元格/格内换行归一化）
#   chromadb           → numpy 精确检索（可选 faiss），索引按「模型_维度」分目录
#   langchain          → 不需要；检索/生成/引用全部自实现
#   rank_bm25          → 自实现 BM25（jieba 分词 + 倒排表，单查 5.2 ms）
#   ragas              → **未运行**；评测改用确定性指标（见 优化/评估结果/*.json），严禁伪造 RAGAS 数值
#   pandas             → 评估产物用标准库 csv/json 写出
# =============================================================================
