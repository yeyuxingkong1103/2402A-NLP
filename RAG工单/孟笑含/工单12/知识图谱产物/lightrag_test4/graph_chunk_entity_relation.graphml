    <node id="Risk Factors">
      <data key="d0">Risk Factors</data>
      <data key="d1">concept</data>
      <data key="d2">A section in the prospectus listing special risks, including the risk of research and trial production of new technologies and new products, and the risk of high industry and customer concentration.</data>
      <data key="d3">doc-c60bf31ac967823de21d6afc2fd6ea18-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1791292538</data>
