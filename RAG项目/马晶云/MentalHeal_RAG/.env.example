# Application
APP_NAME=MentalHeal RAG
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_API_BASE_URL=http://localhost:8000/api/v1

# Security
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
ENABLE_STREAMING=true

# MinerU
MINERU_API_KEY=your-mineru-api-key
MINERU_BASE_URL=https://mineru.net/api
MINERU_API_VERSION=v4
MINERU_MODEL_VERSION=pipeline
MINERU_POLL_SECONDS=5
MINERU_TIMEOUT_SECONDS=1800
MINERU_IS_OCR=true

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=mentalheal_rag

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RAG_CACHE_TTL_SECONDS=600
DOCUMENT_STATUS_TTL_SECONDS=86400

# Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_COLLECTION_KNOWLEDGE=knowledge_chunks
MILVUS_COLLECTION_MEMORY=long_term_memories
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=HNSW

# Embedding and Rerank
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16

# RAG
RAG_TOP_K=20
BM25_TOP_K=20
RAG_RERANK_TOP_K=5
RAG_RERANK_CANDIDATES=8
RAG_SCORE_THRESHOLD=0.35
RAG_CONTEXT_MAX_CHARS=8000
RAG_VECTOR_WEIGHT=0.25
RAG_RERANK_WEIGHT=0.30
RAG_LEXICAL_WEIGHT=0.45
RAG_BM25_WEIGHT=0.20
RAG_MAX_CHUNKS_PER_DOCUMENT=2
RAG_MAX_CHUNKS_PER_PAGE=2
CHAT_HISTORY_MAX_ROUNDS=10

# Files
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
CLEANED_DATA_DIR=./data/cleaned
CHUNKS_DATA_DIR=./data/chunks
VECTORIZED_DATA_DIR=./data/vectorized
FAILED_DATA_DIR=./data/failed
LOG_DIR=./logs
UPLOAD_MAX_SIZE_MB=100
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg

# OCR
OCR_ENGINE=paddleocr
ENABLE_OCR=true
ENABLE_MINERU=true
MINERU_IS_OCR=true
ENABLE_PADDLEOCR_VL=true
PADDLEOCR_LANG=ch
PADDLEOCR_USE_GPU=false
INGESTION_CHUNK_SIZE=1200
INGESTION_CHUNK_OVERLAP=160

# Logging
LOG_LEVEL=INFO

# Evaluation
RAGAS_EVALUATOR_MODEL=deepseek-chat
