# ==================== 环境变量（含密钥，严禁提交） ====================
.env
.env.local

# ==================== Python ====================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ==================== 日志（运行时产物） ====================
logs/
*.log
*.log.*

# ==================== 数据（解析中间产物，可重新生成） ====================
data/parsed/
data/images/
data/avatars/

# 知识库源 PDF：出于版权与体积考虑不入库，保留 .gitkeep 说明获取方式
data/source_docs/*.pdf

# ==================== 临时产物 / 本地备份快照 ====================
_kb_dump.txt
backup_before_ui_v2/
experiment_backup_v3/
.superpowers/

# ==================== 防止密钥再次混入 ====================
# 兜底：任何层级的 .env 都不入库（快照目录里曾出现过）
**/.env

# ==================== 评测中间产物（保留最终报告，忽略逐条明细） ====================
eval/eval_result/*.tmp.json
eval/eval_result/*.raw.json

# ==================== 模型权重（体积大，走本地路径或 ModelScope 缓存） ====================
models/

# ==================== 数据库本地文件 ====================
*.db
*.sqlite3

# ==================== 编辑器 / 系统 ====================
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==================== 测试与覆盖率 ====================
.pytest_cache/
.coverage
htmlcov/
