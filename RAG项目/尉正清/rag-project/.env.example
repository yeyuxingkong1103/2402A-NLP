# 复制为 .env 后按实际情况填写：
#   cp .env.example .env
# 已存在的同名环境变量优先于本文件，部署时可用环境变量覆盖敏感项。

# ==================== 大模型（DeepSeek） ====================
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
# deepseek-flash 是推理模型，会先输出 reasoning_content；
# max_tokens 给小了会导致正文为空，默认 4096
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120

# ==================== 向量库（Milvus） ====================
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=rag_knowledge
MILVUS_MEMORY_COLLECTION=long_term_memory

# ==================== 缓存（Redis） ====================
REDIS_HOST=localhost
REDIS_PORT=6379
# 换成你自己的密码。Redis 常被扫描，别用弱口令
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ==================== 关系库（MySQL） ====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
# 换成你自己的密码。MySQL 8 默认策略要求含大小写字母、数字与符号
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=rag_roleplay
MYSQL_CHARSET=utf8mb4

# ==================== 本地模型路径 ====================
# 从 HuggingFace 下载后放到这两个目录（合计约 4.5GB）
#   BAAI/bge-m3               -> EMBEDDING_MODEL_PATH
#   BAAI/bge-reranker-v2-m3   -> RERANKER_MODEL_PATH
EMBEDDING_MODEL_PATH=/root/models/bge-m3
RERANKER_MODEL_PATH=/root/models/bge-reranker-v2-m3
EMBEDDING_DIM=1024

# ==================== PDF 解析（MinerU） ====================
# MinerU 装在项目内的独立 venv（它要求 openai<3，与主环境的 3.x 冲突）。
# 找不到这个可执行文件时，pdf_service 会自动退回三件套兜底
# （PyMuPDF 文本层 + PaddleOCR 图表文字 + pdfplumber 表格）。
MINERU_BIN=./mineru/.venv/bin/mineru-kit
# 解析档位：basic = 小模型（版面+OCR+公式+表格），无需 VLM
# standard/advanced 要多跑一个 VLM，本机无可用 CUDA，单次加载 361 秒，不实用
MINERU_TIER=basic
# 模型源。本机 huggingface.co 直连不通，必须走 modelscope
MINERU_MODEL_SOURCE=modelscope
# 单份文档解析超时（秒）。basic 档实测 28 页约 38 秒
MINERU_TIMEOUT=1800

# ==================== 记忆策略 ====================
SHORT_TERM_TURNS=10
LONG_TERM_TOP_K=3
MEMORY_SUMMARY_TRIGGER=6

# ==================== 检索策略 ====================
RETRIEVE_LIMIT=20
RERANK_TOP_K=5
# 查询扩写条数：1 = 关闭扩写
QUERY_EXPAND_N=3
# 元数据路召回（按法条号精确命中）
ENABLE_METADATA_ROUTE=true
