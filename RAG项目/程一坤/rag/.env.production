# =============================================================================
# 生产环境配置（ENVIRONMENT=production）
#
# 加载语义（批次 33）：ENVIRONMENT=production 时 config.py 只认本文件，
# 缺失直接报错拒绝启动（不许静默回退默认值）；同时触发 9 个必填键校验
# （EMBEDDING_API_KEY / RERANKER_API_KEY / LLM_API_BASE_URL / LLM_API_KEY /
#   LLM_MODEL / SMTP_HOST / SMTP_USERNAME / SMTP_PASSWORD / SMTP_FROM_EMAIL）
# 与 REDIS_URL 非默认值校验，缺任何一项启动期即失败（config_loader.py）。
#
# 部署前必须把 <...> 占位符全部替换为真实值；真实密钥只放服务器，不入交付物。
# =============================================================================

# ---------------- 应用 ----------------
APP_NAME=legal-rag-character
ENVIRONMENT=production
# 生产用 INFO：保留排障所需请求日志，又不至于 DEBUG 级刷盘
LOG_LEVEL=INFO

# ---------------- MySQL（生产实例）----------------
MYSQL_HOST=<production-mysql-host>
MYSQL_PORT=3306
MYSQL_DATABASE=legal_rag
MYSQL_USER=<production-mysql-user>
MYSQL_PASSWORD=<production-mysql-password>
DATABASE_URL=mysql+pymysql://<user>:<password>@<production-mysql-host>:3306/legal_rag

# ---------------- Redis（生产实例，必须带密码；不允许沿用默认连接串）----------------
REDIS_URL=redis://:<production-redis-password>@<production-redis-host>:6379/0
SESSION_TTL_SECONDS=86400

# ---------------- Milvus（生产实例）----------------
MILVUS_HOST=<production-milvus-host>
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=legal_documents
MILVUS_LONG_TERM_COLLECTION_NAME=legal_long_term_memory

# ---------------- Embedding（必须与建索引时同一模型/维度，否则检索错位）----------------
EMBEDDING_API_BASE_URL=<embedding-endpoint>
EMBEDDING_API_KEY=<your-embedding-api-key>
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_DIMENSION=1024
EMBEDDING_RETRY_ATTEMPTS=3
EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
EMBEDDING_RETRY_TOTAL_BUDGET_SECONDS=15

# ---------------- Reranker ----------------
RERANKER_API_BASE_URL=<reranker-endpoint>
RERANKER_API_KEY=<your-reranker-api-key>
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_SECONDS=60

# ---------------- 检索与回答调参（生产用调优后的值）----------------
# 拒答阈值：两簇中点 0.6304（阶段 8.4 校准）；复算命令 python evaluation/calibrate_refusal.py
REFUSAL_MIN_VECTOR_SCORE=0.6304
# 召回窗口 20/20/20（批次 11 实测回退值，勿改回 40/40/40）
RECALL_VECTOR_LIMIT=20
RECALL_KEYWORD_LIMIT=20
RERANK_CANDIDATE_LIMIT=20
SYNONYM_EXPANSION_ENABLED=false
SYNONYM_TABLE_PATH=data/legal_synonyms_v1.json
SYNONYM_EXPANSION_WEIGHT=1.0

# ---------------- LLM（OpenAI 兼容接口）----------------
LLM_API_BASE_URL=<llm-endpoint>
LLM_API_KEY=<your-llm-api-key>
LLM_MODEL=<your-llm-model>
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# ---------------- 长期记忆 / 会话摘要 ----------------
LONG_TERM_MEMORY_DEDUP_THRESHOLD=0.70
LONG_TERM_MEMORY_TOP_K=5
SESSION_SUMMARY_ENABLED=false

# ---------------- SMTP（生产必填：验证码真发信，缺任一键启动失败）----------------
SMTP_HOST=<smtp-host>
SMTP_PORT=465
SMTP_USERNAME=<your@qq.com>
SMTP_PASSWORD=<your-smtp-auth-code>
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=<your@qq.com>

# =============================================================================
# P1 扩展预留（MinerU / Qwen-VL，可选能力，不配只影响 PDF 解析）
# 接入时见 backend/.env.example 附表
# =============================================================================
