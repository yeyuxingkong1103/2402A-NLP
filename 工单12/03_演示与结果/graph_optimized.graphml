      <data key="d0">content</data>
      <data key="d1">The company's articles that, together with relevant laws and regulations, provide the basis for The Company's corporate governance structure.</data>
      <data key="d2">doc-60a51f5046e89b8028c2464899fc67ff-chunk-000</data>
      <data key="d3">unknown_source</data>
    </node>
