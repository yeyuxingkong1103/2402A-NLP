# =============================================================================
# 环境变量覆盖示例：复制为 .env 使用（.env 优先于 configs/config.yaml）
# 所有项均可省略，省略时使用 configs/config.yaml 中的默认值。
# =============================================================================

# ---- 服务 ----
ROLE_RAG_HOST=127.0.0.1
ROLE_RAG_PORT=8020
ROLE_RAG_ENV=dev
ROLE_RAG_LOG_LEVEL=INFO
ROLE_RAG_WARMUP=true          # 启动后台预热模型与 BM25（false 可跳过）

# ---- 模型根目录（模型统一取自这里，默认 D:/modelscope）----
ROLE_RAG_MODELS_ROOT=D:/modelscope
ROLE_RAG_EMBED_MODEL=D:/modelscope/bge-m3
ROLE_RAG_LLM_MODEL=D:/modelscope/Qwen3-0.6B
ROLE_RAG_DEVICE=cuda
ROLE_RAG_LLM_MAX_NEW_TOKENS=700

# ---- Milvus（WSL 内 docker 启动 standalone）----
ROLE_RAG_MILVUS_URI=http://127.0.0.1:19530
ROLE_RAG_MILVUS_TOKEN=

# ---- Redis（WSL 内 redis-server，密码 123456）----
ROLE_RAG_REDIS_HOST=127.0.0.1
ROLE_RAG_REDIS_PORT=6379
ROLE_RAG_REDIS_PASSWORD=123456
ROLE_RAG_REDIS_DB=0

# ---- 检索 ----
ROLE_RAG_FINAL_K=6
ROLE_RAG_CACHE_ENABLED=true

# ---- 安全（生产环境务必修改）----
ROLE_RAG_SECRET=change-me-in-production
