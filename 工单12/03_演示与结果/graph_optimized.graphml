    <node id="Product Quality">
      <data key="d0">concept</data>
      <data key="d1">A key criterion that electronic product manufacturers use when selecting suppliers, alongside purchase price, service, and supply capability; suppliers are judged on their reaction speed and ability to help solve problems after quality incidents.</data>
      <data key="d2">doc-ffae8e16f46e5532dd542fca62bfc7f2-chunk-000</data>
      <data key="d3">unknown_source</data>
    </node>
