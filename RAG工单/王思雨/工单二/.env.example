# 工单编号：人工智能NLP-RAG-基于PDF文档的问答系统优化
# 本文件由 src/config.py 启动时载入（已存在的真实环境变量优先，不会被覆盖）。
# 注意：路径一律用正斜杠写法，写成 D:\模型\bge-m3 时 "\b" 会被当成退格符。

# ============ 大模型（DeepSeek，OpenAI 兼容接口）============
DEEPSEEK_API_KEY=sk-在这里填写你的DeepSeek密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ============ 本地模型 ============
EMBED_MODEL_PATH=D:/模型/bge-m3
RERANK_MODEL_PATH=D:/模型/bge-reranker-v2-m3
DEVICE=cuda
EMBED_DIM=1024

# ============ 向量库与缓存 ============
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=gd2_opt_chunks
MILVUS_COLLECTION_BASE=gd2_base_chunks
REDIS_URL=redis://localhost:6379/0

# ============ 解析 ============
PDF_PATH=data/招股说明书1.pdf
MINERU_LANGFIX_DIR=C:/mineru_models/langfix

# ============ 检索与分块（调参入口，改这里即可，无需改代码）============
BASE_CHUNK_SIZE=500
SEM_CHUNK_MAX=700
SEM_THRESHOLD=0.62
VEC_TOP_K=20
BM25_TOP_K=20
FUSION_TOP_K=25
RERANK_TOP_N=6
VEC_WEIGHT=0.7
BM25_WEIGHT=0.3
