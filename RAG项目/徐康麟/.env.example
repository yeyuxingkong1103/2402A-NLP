# ==========================================================================
# ⚠️ 重要：本模板是「离线安全兜底」——直接照抄不会连任何真实后端
# ==========================================================================
# 下面第三节的三行默认值刻意是**零依赖兜底实现**（不下载模型、不外呼）：
#
#   VECTOR_STORE=memory            → 内存向量库（数据不持久，重启即丢）
#   EMBEDDING_PROVIDER=offline     → 哈希/离线嵌入（256 维，不是 bge-m3）
#   EMBEDDING_DIM=256              → 与 offline 嵌入配套的维度提示
#
# 要走**真实后端**，必须**同时**改这三项（只改一项会「看起来正常」但仍是兜底）：
#
#   VECTOR_STORE=milvus            # 或 chroma；memory 只用于本地调试
#   EMBEDDING_PROVIDER=bge_m3      # 或 ollama（走 OLLAMA_BASE_URL 上的 bge-m3）
#   # EMBEDDING_DIM=256            # ★ 把这一行注释掉／删掉（别改成空值，见下）
#
#   ⚠️ 只改 VECTOR_STORE=milvus 会落到「离线 256 维」：store 侧拿不到可实测的
#      embedder 时，会用 EMBEDDING_DIM=256 作兜底提示，与本模板第二节建的
#      1024 维 collection（legal_rag_chunks_bge_m3_1024）维度不符 →
#      触发维度不匹配 → 按 MILVUS_FALLBACK_TO_MEMORY 默认值**正确降级**为内存库
#      （服务照常返回，但数据已脱离 Milvus，/health 会报 store_actual=memory）。
#
#   ⚠️ 也不要手动设 EMBEDDING_DIM=1024：维度必须由 embedder **实测**，
#      bge-m3 实测就是 1024；硬编码的维度一旦与模型不符，就会静默降级。
#      正确做法是**整行注释掉/删掉** EMBEDDING_DIM（等价于不设置该项），
#      维度交给 embedder 实测（bge-m3 = 1024）。
#      （注意：写成 `EMBEDDING_DIM=` 空值与「不设置」等价，见 config._env 的
#       空串处理，实际仍然走代码内默认值；所以推荐直接注释掉整行。）
#
# 连上真实后端后，用 GET /health 确认 store_actual / embedding provider
# 是真实实现（不是 memory / offline），再开始入库。
# ==========================================================================

# ==========================================================================
# 法律 RAG 服务环境变量示例
# ==========================================================================
# 用法：复制为 .env（或直接 export）后按需修改；.env 已在 .gitignore 中，不会被提交。
# 注意：任何密钥都不要写进代码或提交到仓库；本文件只放占位值。
#
# 【取值速查】默认「本地优先（127.0.0.1）」—— ⚠️ 这是一次**行为变更**
#
#   ⚠️ 旧版本不设 MILVUS_HOST / REDIS_URL 时默认连 Ubuntu VM 192.168.188.128；
#      现在代码内默认值一律是本机 127.0.0.1。**要连远端（保留旧 VM 或另一台机器）
#      必须显式设置 MILVUS_HOST / REDIS_URL**，不再有隐式远端默认值。
#
#   配置项              Windows 宿主                      WSL / Linux（本机 Docker）
#   ----------------    ------------------------------    ----------------------------------
#   OLLAMA_BASE_URL     http://127.0.0.1:11434（本机）     http://127.0.0.1:11434（本机）
#   MILVUS_HOST         127.0.0.1（本机 Docker/端口映射）  127.0.0.1（本机 Docker）
#   REDIS_URL           redis://127.0.0.1:6379/0          redis://127.0.0.1:6379/0
#   LLM_MODEL           qwen2.5:3b                         qwen2.5:3b（CPU ≈4.5 tok/s）
#
#   连远端的写法（按实际情况替换 <远端机器>）：
#     MILVUS_HOST=<远端机器>
#     REDIS_URL=redis://<远端机器>:6379/0
#     OLLAMA_BASE_URL=http://<远端机器>:11434
#   ⚠️ WSL 里连 **Windows 宿主**上的 Ollama：WSL 内的 127.0.0.1 指 WSL 自己，
#      必须用宿主 IP（见 docs/WSL.md 第 2 节），例如 http://172.x.x.x:11434。

# ==========================================================================
# 一、Ollama（嵌入 + 生成；免密钥、免 torch）
# ==========================================================================
# 每台机器用它自己那份 Ollama；bge-m3 做嵌入、qwen2.5:3b 做生成。
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 嵌入模型：bge-m3（实际输出维度 1024）
EMBEDDING_MODEL=bge-m3
# 生成模型：qwen2.5:3b（CPU 上约 4.5 tok/s；有 GPU 时自动上卡）
LLM_MODEL=qwen2.5:3b
LLM_PROVIDER=ollama
# 免密钥部署留空；若经 Open WebUI/网关转发再填
OLLAMA_API_KEY=
# 模型常驻时长，避免 CPU 场景反复加载（Ollama 默认 5m）
OLLAMA_KEEP_ALIVE=10m
# 留空 = 交给 Ollama 自动选（Win 有卡走 GPU，VM 自动回落 CPU）
OLLAMA_NUM_GPU=
OLLAMA_NUM_THREAD=

# ==========================================================================
# 二、Milvus 向量库（gRPC）
# ==========================================================================
# 默认连本机 127.0.0.1（WSL / Docker Desktop 里起的 Milvus 都能命中）。
# ⚠️ 行为变更：旧版本默认连 Ubuntu VM 192.168.188.128；要连远端必须在此显式填写。
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# 本阶段新建的 collection（绝不触碰既有 user_long_term_memory / ragas_test_collection）
MILVUS_COLLECTION=legal_rag_chunks_bge_m3_1024
# 直接用 URI 覆盖 host/port（留空则用上面两项拼）
MILVUS_URI=
# 免 token 部署留空
MILVUS_TOKEN=
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=default
MILVUS_CONNECT_TIMEOUT=10
MILVUS_TIMEOUT=30
# 维度不匹配时是否自动重建 collection；默认 false（保护数据，只报错不删）
MILVUS_RECREATE_ON_DIM_MISMATCH=false
# Milvus 连不上/维度不匹配时，是否降级为内存向量库。
#   取值：1/true/yes/on 开，0/false/no/off 关（大小写不敏感）；非法值保守取默认 true 并记 warning。
#   默认 true（保证服务不崩）。
#   ⚠️ 打开降级的代价：内存库【数据不持久】—— 向量只在进程内存里，重启即全部丢失，
#      多进程/多 worker 之间也互不可见；检索仍会返回结果，于是「看起来正常」实则已脱离 Milvus。
#      降级发生时 /health 的 engine 块会报 status=degraded / store_actual=memory / degraded_reason。
#   使用场景：本机没有 Milvus 的本地调试（如 Windows 未启动 Docker）→ 留 true；
#            VM 试运行 / 生产 → 建议置 0，让连不上直接抛 MilvusUnavailableError，不要静默降级。
#   PowerShell 用法：$env:MILVUS_FALLBACK_TO_MEMORY="0"
MILVUS_FALLBACK_TO_MEMORY=true
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE

# ==========================================================================
# 三、向量化 / 重排（旧字段，保持兼容）
# ==========================================================================
# VECTOR_STORE:       memory | chroma | milvus
# EMBEDDING_PROVIDER: offline | bge_m3 | ollama
# RERANK_PROVIDER:    cosine | bge_rerank
VECTOR_STORE=memory
VECTOR_COLLECTION=legal_kb
EMBEDDING_PROVIDER=offline
EMBEDDING_DIM=256
RERANK_PROVIDER=cosine
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ==========================================================================
# 四、大模型（云端，属下一阶段；本阶段主线走 Ollama）
# ==========================================================================
LLM_FALLBACKS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_COMPAT_BASE_URL=
OPENAI_API_KEY=

# ==========================================================================
# 五、CPU 性能（VM 无 GPU，默认值刻意保守）
# ==========================================================================
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_MAX_RETRIES=2
# 最终喂给大模型的上下文条数（0.5 tok/s 级算力下 3 条 ≈ 1.8k 字符）
RETRIEVAL_FINAL_TOP_K=3
CONTEXT_MAX_CHARS=1800

# ==========================================================================
# 六、并发
# ==========================================================================
MAX_CONCURRENT_REQUESTS=8
THREAD_POOL_SIZE=8
INGEST_WORKERS=4
QUEUE_MAX_SIZE=100

# ==========================================================================
# 七、超时（秒）
# ==========================================================================
EMBED_TIMEOUT=60
LLM_TIMEOUT=180
# MILVUS_TIMEOUT 见第二节，默认 30

# ==========================================================================
# 八、PDF 上传与入库
# ==========================================================================
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
MAX_UPLOAD_FILES=10
UPLOAD_ALLOWED_EXT=.pdf

# ==========================================================================
# 九、记忆与业务数据（Redis 只用 legal_rag: 前缀，禁止 flush 已有用户 key）
# ==========================================================================
SESSION_WINDOW=20
# 默认连本机 127.0.0.1 的 Redis；要连远端（保留旧 VM 或另一台机器）必须在此显式填写。
REDIS_URL=redis://127.0.0.1:6379/0
# key 前缀隔离（服务侧绝不执行 FLUSHDB/FLUSHALL）
REDIS_PREFIX=legal_rag:
LONGTERM_ENABLED=false
LONGTERM_THRESHOLD=20
# 留空则使用 SQLite 兜底（index/legal_rag.db）
MYSQL_DSN=
# MYSQL_DSN=mysql://root:password@127.0.0.1:3306/legal_rag

# 嵌入缓存（Redis 优先，失败回落内存）
EMBED_CACHE_ENABLED=true
EMBED_CACHE_BACKEND=redis
CACHE_PREFIX=legal_rag:
# 7 天
EMBED_CACHE_TTL=604800
EMBED_CACHE_MAX_ITEMS=2048

# ==========================================================================
# 十、服务
# ==========================================================================
API_HOST=127.0.0.1
API_PORT=8000
STREAM=true

# ==========================================================================
# 十一、日志与指标
# ==========================================================================
# INFO 只记汇总，逐条明细用 DEBUG
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=app.log
# 置 0 可关闭滚动文件（仅控制台）
LOG_TO_FILE=1
# 滚动策略默认 20MB × 5 备份；VM 磁盘紧张时可调小
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=5
# 第三方库（httpx/pymilvus/urllib3…）压到 WARNING
LOG_NOISY_LEVEL=WARNING
# 0~1：高频路径 @traced 采样率（1 = 全采）
TRACE_SAMPLE=1.0
# --- P0.5 耗时评估（详见 docs/REFACTOR-PLAN.md §3.7）---
# L3「函数前后日志」的级别：DEBUG 看得最全；留空 = 跟随 LOG_LEVEL。
# 为什么单独一个键：@traced 默认 DEBUG 而 LOG_LEVEL 默认 INFO，会让「耗时 X.Xms」
# 这一行被静默过滤掉（历史问题）。有了它就能"只放量函数日志、不放量第三方噪声库"。
TRACE_LEVEL=
# L2「慢调用清单」阈值（毫秒）：超过才打一行 [SLOW]；<=0 关闭该日志。
# 注意：它**只影响日志行**，不影响 L1 直方图 func_seconds（那项永远全量统计）。
SLOW_CALL_MS=500
# L2 日志行采样率（0~1）：慢调用很多时可调小；默认 1 = 一条不丢。
SLOW_CALL_SAMPLE=1.0
# 打 METRIC JSON 行 + 人类可读摘要行（scripts/perf_report.py --log 就是解析它）
METRICS_LOG_ENABLED=true
# 自定义延迟分桶（秒），留空用默认 0.005…32
METRICS_BUCKETS=

# ==========================================================================
# 十二、系统层指标（t6 使用；psutil / nvidia-ml-py 为可选增强）
# ==========================================================================
SYS_METRICS_ENABLED=true
# 采样间隔（秒）
SYS_METRICS_INTERVAL=15
# Windows 有 RTX 2060 可开；VM 无卡留 1 也会自动跳过
SYS_GPU_ENABLED=true

# ==========================================================================
# 十三、一键离线（兜底演示：不连任何真实后端）
# ==========================================================================
# 置 1 时强制：内存向量库 + 零依赖向量化 + 余弦重排 + Mock 大模型
RAG_OFFLINE=

# ==========================================================================
# 十四、网页控制台（/ui）与「入库前判定」
# ==========================================================================
# 网页由 FastAPI 直接托管：启动后访问 http://127.0.0.1:<API_PORT>/ui
# ⚠️ 本机 **8000 / 8080 / 9000** 绑不上（WinError 10048，但 netstat 里没有进程在听）
#    —— 实测是这台机器的策略挡住的，换 8001 / 8100 / 18080 即可。
#    脚本 `scripts/run_api.py` 会自动读本文件（已存在的环境变量优先）。
API_PORT=8001

# ---- 本机跑真实链路（Windows 宿主 + Ollama；免密钥、用本机 GPU）----
# 不设这三项就退回默认的 mock/offline，网页答的是"假答案"（Mock 回显）
VECTOR_STORE=milvus
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama
# bge 重排需要 sentence-transformers（本机没装），实测用 cosine
RERANK_PROVIDER=cosine

# ---- 入库前判定：「这份资料是否符合该角色设定」 ----
# auto（默认）= 有 DEEPSEEK_API_KEY 就用 deepseek，否则用 Ollama；都没有则如实报「无法判定」
FIT_CHECK_PROVIDER=auto
# 留空则按 provider 取默认（deepseek -> deepseek-chat；ollama -> Ollama 的 llm_model）
FIT_CHECK_MODEL=
# 送给裁判的正文节选上限 / 裁判回答上限
FIT_CHECK_SAMPLE_CHARS=3000
FIT_CHECK_MAX_TOKENS=300
# 用 DeepSeek 当裁判时填这里（没填就自动退到本地 qwen2.5:3b，功能照常可用）
# DEEPSEEK_API_KEY=sk-xxxxxxxx
