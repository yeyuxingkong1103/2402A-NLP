# 工单编号：人工智能NLP-RAG-基于PDF文档的问答系统
# .env 模板 —— 新环境部署时复制为 .env 再改：
#     copy .env.example .env        （Windows）
#     cp   .env.example .env        （Git Bash / Linux）
#
# 为什么需要这个文件：.env 含密钥、已被 .gitignore 排除，
# 所以从版本库克隆出来的新环境**没有 .env** —— 文档里写的"编辑 .env"在新机器上是悬空的。
#
# 两点须知：
#   1. 所有变量都有默认值（见 app/config.py），缺项不会导致启动失败，
#      但 LLM_API_KEY 缺了会在提问时报错，EMBEDDING_MODEL_PATH / RERANKER_MODEL_PATH
#      缺了会指向本机路径 D:/模型/... 而在新机器上找不到模型。
#   2. **路径一律用正斜杠**：写成 D:\模型\bge-m3 时 "\b" 会被解析成退格符。
#   3. 本文件用行内 # 注释，加载器会按第一个 # 截断值，可放心写注释。

# ---------------- 大模型（DeepSeek） ----------------
# 必填。两种写法都认：系统环境变量 DEEPSEEK_API_KEY 优先，其次才是这里的 LLM_API_KEY
LLM_API_KEY=sk-在这里填你的Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=60
# 必须为 none：deepseek-v4-flash 是推理模型，不关推理会把 max_tokens 吃光并返回空答案
LLM_REASONING_EFFORT=none
# RAGAS 判官输出上限（仅评估时用到）
EVAL_JUDGE_MAX_TOKENS=2048

# ---------------- 本地模型（**换成你自己的模型路径**） ----------------
EMBEDDING_MODEL_PATH=D:/模型/bge-m3
RERANKER_MODEL_PATH=D:/模型/bge-reranker-v2-m3
# 无 GPU 也能跑，改成 cpu 即可，代价是索引与检索慢 5~10 倍
EMBED_DEVICE=cuda
EMBED_DIM=1024
EMBED_MAX_TOKENS=1024

# ---------------- 向量库与缓存 ----------------
MILVUS_URI=http://localhost:19530
MILVUS_LITE_PATH=data/milvus/lite.db
MILVUS_COLLECTION=pdf_chunks
REDIS_URL=redis://localhost:6379/0
# Redis 5 不支持 RESP3，必须为 2（redis-py 8.x 默认发 HELLO 会报 unknown command）
REDIS_PROTOCOL=2

# ---------------- 检索与分块参数（调参项，全部有默认值） ----------------
CHUNK_MIN_CHARS=350
CHUNK_MAX_CHARS=600
SEMANTIC_BREAK_PERCENTILE=50
RETRIEVE_TOP_K=80
# 送进重排模型的候选数 —— 重排耗时的唯一决定量。默认 60。
# 实测降到 30 可省约 0.45s 且 10 题准确率无可测损失，但**未采纳**（10 题无余量验证），
# 详见 docs/优化记录.md §9.1；降到 14/20 会掉到 8/10 命中。
# 注意：改动此值会让《测试报告》里全部历史数字失配。
FUSION_TOP_N=60
RERANK_TOP_K=8
# 重排【输出】的截断条数（不限制送入模型的条数，那由 FUSION_TOP_N 决定）
RERANK_POOL=14
RERANK_MIN_SCORE=0.15
CONTEXT_MAX_CHARS=5000

# ---------------- PDF 解析（MinerU） ----------------
MINERU_MODEL_SOURCE=modelscope
# 中文路径补丁目录：本机用户名含中文时必须存在，否则 MinerU 必失败并静默降级到 pymupdf
# （降级会丢掉全部表格结构，详见 docs/部署文档.md §4）
MINERU_LANGFIX_DIR=C:/mineru_models/langfix
MINERU_TIMEOUT=3600
