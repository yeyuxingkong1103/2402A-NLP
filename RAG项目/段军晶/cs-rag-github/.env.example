# ============================================================================
#  计算机专业知识库 RAG 问答助手 —— 环境变量模板
# ----------------------------------------------------------------------------
#  使用方式：
#    1. 复制本文件为 .env      （Windows: copy .env.example .env）
#    2. 按下方注释填写实际值
#    3. .env 已被 .gitignore 忽略，不会提交到版本库，可安全存放密钥
# ----------------------------------------------------------------------------
#  注意：路径建议使用正斜杠 / ，避免反斜杠被转义导致读取失败
# ============================================================================


# ==================== 一、应用服务配置 ====================

# 服务监听地址。0.0.0.0 表示允许局域网内其他机器访问；仅本机访问可改为 127.0.0.1
APP_HOST=0.0.0.0

# 服务监听端口
APP_PORT=8000

# 服务标题（显示在接口文档页面上）
APP_TITLE=计算机专业知识库 RAG 问答助手


# ==================== 二、数据路径配置 ====================

# 知识库源 PDF 存放目录（相对于项目根目录）
SOURCE_DOCS_DIR=data/source_docs

# MinerU 解析产物输出目录
PARSED_DIR=data/parsed

# 日志输出目录
LOGS_DIR=logs

# 评测集与评测结果目录
EVAL_DIR=eval


# ==================== 三、Milvus 向量数据库配置 ====================

# Milvus 服务地址
MILVUS_HOST=127.0.0.1

# Milvus 服务端口
MILVUS_PORT=19530

# 集合名称。V2/V3 迭代时可改为新集合名做版本对比，互不干扰
MILVUS_COLLECTION=cs_kb_chunks

# 向量维度。BGE-M3 输出为 1024 维，请勿随意修改
MILVUS_DIM=1024

# 建索引与检索的相似度度量方式。BGE-M3 推荐 COSINE（余弦相似度）
MILVUS_METRIC_TYPE=COSINE

# HNSW 索引参数：M 越大精度越高、内存占用越大
MILVUS_HNSW_M=16

# HNSW 索引参数：efConstruction 越大建索引越慢、精度越高
MILVUS_HNSW_EF_CONSTRUCTION=200


# ==================== 四、MySQL 业务元数据库配置 ====================
# 说明：MySQL 是页码溯源的唯一真相源，存放文档元信息与 chunk 元数据

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root

# 请填写你的 MySQL 密码
MYSQL_PASSWORD=your_mysql_password

# 业务库名。首次运行时会自动创建（如账号无建库权限，请手工创建）
MYSQL_DATABASE=cs_rag

# 字符集，中文场景必须为 utf8mb4
MYSQL_CHARSET=utf8mb4


# ==================== 五、Redis 缓存 / 会话配置 ====================
# 说明：Redis 承担多轮对话的短期记忆与高频查询缓存

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 无密码则留空
REDIS_PASSWORD=

# Redis 逻辑库编号（0-15）
REDIS_DB=0

# 会话有效期（秒）。默认 1800 秒 = 30 分钟，超时自动清理
SESSION_TTL_SECONDS=1800

# 会话记忆保留的最大对话轮数，超出后丢弃最早的轮次
SESSION_MAX_TURNS=5

# 高频查询缓存有效期（秒）。默认 3600 秒 = 1 小时
CACHE_TTL_SECONDS=3600


# ==================== 六、生成大模型配置（deepseek-v4-flash）====================
# 说明：负责基于检索到的原文片段生成最终答案

# DeepSeek API 密钥，形如 sk-xxxxxxxx
DEEPSEEK_API_KEY=your_deepseek_api_key

# DeepSeek 接口地址（OpenAI 兼容）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称。任务书要求的 deepseek-v4-flash 在本接口对应的模型名为 deepseek-flash
DEEPSEEK_MODEL=deepseek-v4-flash

# 生成温度。问答场景要求忠于原文，建议保持较低值以减少发挥
LLM_TEMPERATURE=0.1

# 单次生成的最大 token 数。
# 注意：deepseek-v4-flash 是推理模型，会先输出 reasoning_content（推理过程）
# 再输出 content（正式答复），**两者共用本预算**。预算过小时推理会吃光额度，
# 导致 finish_reason=length 且 content 为空（即空答案）。
# 实测 1024 不够用（129 次生成有 10 次触顶并产生过空答案），故设为 4096。
LLM_MAX_TOKENS=8192

# 生成请求超时时间（秒）
LLM_TIMEOUT=60


# ==================== 七、视觉理解模型配置（通义千问 VL）====================
# 说明：V2 用于解析 PDF 中的图表、流程图，把图形语义补充进知识库
# 本项目按可插拔 Provider 设计，更换视觉模型只需修改以下三项，无需改动业务代码

# 是否启用视觉解析。
# V1（朴素稠密检索）不需要，可设为 false；
# V2 起用视觉模型解析 PDF 图表，需设为 true，并确保 VISION_API_KEY 已填写。
VISION_ENABLED=true

# 通义千问 VL 的 API 密钥（阿里云百炼平台）
VISION_API_KEY=your_dashscope_api_key

# 接口地址（OpenAI 兼容模式）
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 视觉模型名称，如 qwen-vl-plus / qwen-vl-max
VISION_MODEL=qwen-vl-plus

# 视觉模型请求超时时间（秒）。图片解析较慢，建议给足
VISION_TIMEOUT=120


# ==================== 八、本地向量与重排模型配置 ====================
# 说明：两个模型均为本地权重，无需联网、无调用费用

# BGE-M3 向量模型路径（同时提供稠密、稀疏、多向量三种输出）
BGE_M3_PATH=D:/桌面/模型/bge-m3

# BGE-reranker-v2-m3 重排模型路径（V3 使用）
BGE_RERANKER_PATH=D:/桌面/模型/bge-reranker-v2-m3

# 推理设备。无 GPU 保持 cpu
EMBED_DEVICE=cpu

# 向量化批大小。CPU 环境建议 8-16，过大会内存吃紧
EMBED_BATCH_SIZE=8

# 输入文本最大长度（token）
EMBED_MAX_LENGTH=8192


# ==================== 九、MinerU 版面解析配置 ====================

# 解析后端。pipeline 通用性最好，适合 CPU 环境
MINERU_BACKEND=pipeline

# 解析方法，可选 auto / txt / ocr：
#   ocr  —— 强制走 OCR 识别（**本项目必须使用此项**）
#   txt  —— 直接抽取 PDF 文字层，速度最快
#   auto —— 由 MinerU 自动判断
#
# ⚠️ 重要：为什么不能用 txt 模式
#   本项目实测发现，txt 模式在提取文字层时会**丢失行首字符**，例如：
#       "GB/T 11457 信息技术 软件工程术语"  被解析为  "/ 信息技术 软件工程术语"
#       "a）需方依此确定软件质量量化评价需求…" 被解析为  ") 需方依此确定…"
#   对标准知识库而言，标准编号（如 GB/T 16260.1—2006）恰恰是用户最常用的检索线索，
#   一旦丢失，用户按编号提问将完全无法命中。
#   同一页改用 ocr 模式后，上述字符全部完整还原。
#   因此本项目固定使用 ocr 模式，代价是解析耗时增加约一倍（CPU 环境约 10-20 秒/页）。
MINERU_METHOD=ocr

# 文档语言，中文为 ch
MINERU_LANG=ch

# 单份 PDF 解析超时时间（秒）
MINERU_TIMEOUT=3600

# MinerU 无法正常工作时，是否允许降级为轻量解析（降级后页码元数据依然保留）
MINERU_FALLBACK_ENABLED=true


# ==================== 十、文本分块配置 ====================

# 分块大小（字符数）。中文场景 400-600 较为合适
CHUNK_SIZE=500

# 相邻块重叠字符数，避免语义在切分处断裂
CHUNK_OVERLAP=100

# 单块最大字符数上限。表格、图片块超限时按此截断
CHUNK_MAX_CHARS=2000


# ==================== 十一、检索参数配置 ====================

# 最终送入大模型的片段数量
RETRIEVE_TOP_K=5

# 检索阶段先召回的候选数量（V3 重排前的候选池大小）
RETRIEVE_CANDIDATE_K=20

# 相似度下限。低于该分数的片段视为不相关，用于触发拒答判断
RETRIEVE_SCORE_THRESHOLD=0.3

# 稀疏检索中稀疏通道的权重
# 注意：V2 采用 RRF（基于名次）融合，**不使用权重**，该配置项当前无代码读取。
# 保留仅为兼容既有配置；详见技术决策记录 ADR-019。
HYBRID_SPARSE_WEIGHT=0.3

# RRF 融合参数 k（V2 混合检索），融合公式 score = Σ 1/(k + rank)
RRF_K=60

# ==================== 十二、链路版本 ====================

# 服务端使用的检索链路版本：
#   v1 = 朴素稠密检索（V1 基线）
#   v2 = 稠密 + 稀疏 + RRF 混合检索（V2，默认）
#   v3 = 重排 + 查询改写（V3）
# 若某一版本出现异常，改回 v1 即可回退，无需改动任何代码。
PIPELINE_VERSION=v3


# ==================== 十三、重排配置（V3 主链路）====================
# 说明：V3 在 RRF 候选池之上叠加 BGE-reranker 精排，最终顺序由重排决定
#      （RRF 分数与重排分数尺度不同，不混合，见 ADR-023）

# 是否启用重排。
# 开启后：稠密20 + 稀疏20 → RRF → 候选 RERANK_CANDIDATE_K 个 → 重排 → top_k
# 实测 10 个候选 × max_length=256 约 4.2 秒，端到端约 7.1 秒（满足 N3 ≤8 秒）。
# 重排模型不可用或推理超时时，系统自动退回 RRF 原顺序并记 WARNING，不会中断问答。
RERANK_ENABLED=true

# 送入重排的候选数量。越大越准但越慢，每多一个候选约增加 0.42 秒（CPU 环境）
RERANK_CANDIDATE_K=10

# 重排输入的最大 token 长度。实测 512→0.78 秒/对、256→0.39 秒/对、128→0.21 秒/对
RERANK_MAX_LENGTH=256

# 重排推理的批大小。CPU 环境建议 8
RERANK_BATCH_SIZE=8

# 单次重排推理的超时时间（秒）。超时即降级退回 RRF 顺序，避免请求永久挂起
RERANK_TIMEOUT=30


# ==================== 十四、查询改写配置（对照实验分支）====================

# ⚠️ 默认关闭。开启后检索用「原问题 + 改写查询」多路融合，可改善术语类查询的召回，
#    但改写本身耗时 3.2~4.4 秒，会使端到端约 10.5 秒、超出 N3 的 8 秒目标。
#    仅用于对照实验，其耗时与指标单独记录，不计入主口径评测（见 ADR-025）。
QUERY_REWRITE_ENABLED=false

# 最多保留几条改写查询（不含原问题）。条数越多召回越广，但检索耗时线性增长
QUERY_REWRITE_MAX_QUERIES=1

# 查询改写的超时时间（秒）。超时即降级为只用原问题检索，不会中断问答
QUERY_REWRITE_TIMEOUT=20


# ==================== 十五、日志配置 ====================

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志文件名（输出到 LOGS_DIR 目录下）
LOG_FILE=rag_service.log

# 单个日志文件的最大字节数（默认 10MB），超出后滚动
LOG_MAX_BYTES=10485760

# 保留的历史日志文件数量
LOG_BACKUP_COUNT=10

# 是否在控制台同时打印日志
LOG_TO_CONSOLE=true


# ==================== 十六、评测配置 ====================

# 评测时检索的 top-k 列表，用于计算 recall@k
EVAL_TOP_K_LIST=1,3,5,10

# RAGAS 裁判模型使用的模型（复用生成模型的接口）
RAGAS_JUDGE_MODEL=deepseek-v4-flash

# 是否启用 RAGAS 评测（涉及 LLM 调用，会产生费用）
RAGAS_ENABLED=true


# ==================== 十七、JMeter 压力测试提示 ====================
# 本项目不包含 JMeter 脚本。压测请使用 JMeter 对以下接口施压：
#   问答接口：POST http://<服务地址>:<端口>/api/chat/query
#   健康检查：GET  http://<服务地址>:<端口>/api/health
# 详细压测方法与参数建议见 docs/接口文档.md
