{
  "annotations": { "list": [] },
  "editable": true,
  "title": "RAG API 性能与资源监控（工单十七）",
  "uid": "rag-wo17",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["RAG", "工单十七", "并发瓶颈", "资源泄漏"],
  "templating": {
    "list": [
      {
        "name": "variant",
        "label": "版本",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(rag_api_requests_total, variant)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "吞吐量 QPS（按版本）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(rag_api_requests_total[1m])) by (variant)",
          "legendFormat": "{{variant}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "请求延迟 P95（按版本）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_api_request_latency_ms_bucket[5m])) by (le, variant))",
          "legendFormat": "{{variant}} P95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "进程内存 RSS / commit（泄漏核心指标）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "rag_process_rss_bytes", "legendFormat": "RSS {{variant}}" },
        { "expr": "rag_process_private_bytes", "legendFormat": "commit {{variant}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "任务队列积压深度 / 在飞请求",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "rag_task_queue_depth", "legendFormat": "队列深度 {{variant}}" },
        { "expr": "rag_api_inflight", "legendFormat": "在飞请求 {{variant}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "异步解析任务计数（queued / done / failed）",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(rag_tasks_total[1m])) by (status)", "legendFormat": "{{status}}" }
      ]
    }
  ]
}